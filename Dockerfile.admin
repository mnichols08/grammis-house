# Runs open.blog's admin (Studio) on Railway. Serves the site too, at /grammis-house/ and /admin.
# Pins the same open.blog revision as the other workflows. Set this service's Dockerfile path to Dockerfile.admin.

FROM rust:1-bookworm AS build
RUN cargo install --git https://github.com/journey-to-code-org/open.blog \
    --rev 65373fd55d0be0835f512ccd452a4770f9db3c11 openblog-cli

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates nodejs npm \
    && rm -rf /var/lib/apt/lists/* \
    && npm install --global @zubra/compiler@5.8.0
COPY --from=build /usr/local/cargo/bin/openblog /usr/local/bin/openblog
COPY docker/admin-entrypoint.sh /usr/local/bin/admin-entrypoint.sh
RUN chmod +x /usr/local/bin/admin-entrypoint.sh
ENTRYPOINT ["/usr/local/bin/admin-entrypoint.sh"]
