# The family service on Railway: notes on recipes, greeting cards and gifts under the tree.
# It is open.blog's own service (service/ in open.blog, at the same revision as the other files here),
# over Railway's Postgres. Set this Railway service's Dockerfile path to Dockerfile.service, and its
# watch paths to Dockerfile.service, so saves in the editor don't rebuild it.
# scripts/setup-family-service.sh lists the variables it needs.

FROM debian:bookworm-slim AS source
ARG OPENBLOG_REV=718c91393a72a2e282c2585a3ba7cfa763f7c410
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates \
    && git init -q /src && cd /src \
    && git fetch -q --depth 1 https://github.com/journey-to-code-org/open.blog "$OPENBLOG_REV" \
    && git checkout -q FETCH_HEAD

FROM node:22-bookworm-slim
ARG POSTGREST_VERSION=12.2.3
ARG POSTGREST_SHA256=9f71269e61ac3a940281e93ff415760f5957e430e475ba4c3889f3ede7d5527c
RUN apt-get update \
    && apt-get install -y --no-install-recommends postgresql-client ca-certificates curl xz-utils \
    && curl -fsSL -o /tmp/postgrest.tar.xz \
       "https://github.com/PostgREST/postgrest/releases/download/v${POSTGREST_VERSION}/postgrest-v${POSTGREST_VERSION}-linux-static-x64.tar.xz" \
    && echo "${POSTGREST_SHA256}  /tmp/postgrest.tar.xz" | sha256sum -c - \
    && tar -xJf /tmp/postgrest.tar.xz -C /usr/local/bin postgrest \
    && rm /tmp/postgrest.tar.xz \
    && apt-get purge -y xz-utils && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=source /src/netlify ./netlify
COPY --from=source /src/supabase ./supabase
COPY --from=source /src/service ./service
COPY --from=source /src/web/components ./web/components
RUN chmod +x service/entrypoint.sh service/migrate.sh && postgrest --version
USER node
ENV PORT=8080 NODE_ENV=production
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s \
    CMD curl -fsS "http://127.0.0.1:${PORT}/health" > /dev/null || exit 1
ENTRYPOINT ["/app/service/entrypoint.sh"]
