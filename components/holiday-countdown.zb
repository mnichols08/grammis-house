<!--
  A small sign that hangs under the garland: how many days until the holiday.
  `holiday` is "thanksgiving" (the fourth Thursday of November) or "christmas".
  The text inside is what readers see before (or without) JavaScript.
-->
<script>
  const names = { thanksgiving: 'Thanksgiving', christmas: 'Christmas' }

  function dayOf(year) {
    if (holiday === 'christmas') return new Date(year, 11, 25)
    const first = new Date(year, 10, 1).getDay()
    return new Date(year, 10, 1 + ((4 - first + 7) % 7) + 21)
  }

  function daysLeft() {
    const now = new Date()
    const today = new Date(now.getFullYear(), now.getMonth(), now.getDate())
    let day = dayOf(today.getFullYear())
    if (day < today) day = dayOf(today.getFullYear() + 1)
    return Math.round((day - today) / 86400000)
  }

  const name = names[holiday] ?? 'the holiday'
  const left = daysLeft()
  const message = left === 0 ? `Happy ${name}!` : left === 1 ? `${name} is tomorrow!` : `${left} days until ${name}`
</script>
<style>
  :host { display: flex; justify-content: center; position: relative; z-index: 4; margin-top: calc(var(--ob-decor-garland-height, 0px) * -0.12); }
  .sign {
    position: relative;
    margin: 1.4rem 0 0;
    padding: 0.3rem 1.3rem 0.45rem;
    border-radius: 6px;
    background: var(--card, #fffaf0);
    border: 2px solid var(--primary, #8e1b2c);
    color: var(--primary, #8e1b2c);
    font-family: var(--ob-font-hand, cursive);
    font-weight: 700;
    font-size: 1.55rem;
    line-height: 1.15;
    box-shadow: 0 3px 0 color-mix(in srgb, var(--primary, #8e1b2c) 35%, transparent);
    rotate: -1.5deg;
  }
  .sign::before, .sign::after {
    content: "";
    position: absolute;
    bottom: 100%;
    width: 1.5px;
    height: 2.4rem;
    background: var(--muted-foreground, #7e6050);
  }
  .sign::before { left: 18%; rotate: 14deg; transform-origin: bottom; }
  .sign::after { right: 18%; rotate: -14deg; transform-origin: bottom; }
</style>
<holiday-countdown holiday="thanksgiving">
  <p class="sign" role="status">{message}</p>
</holiday-countdown>
