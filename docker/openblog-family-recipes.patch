+/// Where the editor puts the photos of recipes the family shares, under the static folder.
+const FAMILY_PHOTOS: &str = "images/family-recipes";
+
+/// The family's recipe photos that no published post shows (by its address, `/images/…`).
+fn unshown_family_photos(root: &Path, config: &SiteConfig, published: &[&str]) -> Vec<String> {
+    let static_dir = config.paths.static_dir.trim_end_matches('/');
+    let base = root.join(static_dir);
+    let mut out = Vec::new();
+    let mut folders = vec![base.join(FAMILY_PHOTOS)];
+    while let Some(folder) = folders.pop() {
+        let Ok(entries) = std::fs::read_dir(&folder) else {
+            continue;
+        };
+        for entry in entries.flatten() {
+            let path = entry.path();
+            match entry.file_type() {
+                Ok(kind) if kind.is_dir() => folders.push(path),
+                Ok(kind) if kind.is_file() => {
+                    let Ok(rel) = path.strip_prefix(&base) else {
+                        continue;
+                    };
+                    let rel = rel.to_string_lossy().replace('\\', "/");
+                    let address = format!("/{rel}");
+                    if !published.iter().any(|text| text.contains(&address)) {
+                        out.push(format!("{static_dir}/{rel}"));
+                    }
+                }
+                _ => {}
+            }
+        }
     }
+    out.sort();
     out
 }
 
