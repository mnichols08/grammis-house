+const safePhoto = (src) => /^data:image\/(png|jpeg);base64,[A-Za-z0-9+/]+={0,2}$/.test(String(src || ""));
+const lum = (hex) => {
+  const part = (i) => Number.parseInt(String(hex).slice(1 + i * 2, 3 + i * 2), 16) / 255;
+  const lin = (c) => (c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4);
+  const [r, g, b] = [0, 1, 2].map((i) => lin(part(i)));
+  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
+};
+const readable = (hex) => (lum(hex) > 0.4 ? "#1f2633" : "#fffdf8");
+
+function drawStroke(svg, stroke) {
+  const points = Array.isArray(stroke?.points) ? stroke.points : [];
+  if (!points.length) return;
+  const color = String(stroke.color || "#1f2633");
+  const width = Number(stroke.size) || 4;
+  if (points.length < 2) {
+    const [x, y] = points[0];
+    svg.append(el("circle", { cx: x, cy: y, r: Math.max(1, width / 2), fill: color }));
+    return;
+  }
+  svg.append(el("polyline", {
+    points: points.map((point) => `${Number(point[0])},${Number(point[1])}`).join(" "),
+    fill: "none", stroke: color, "stroke-width": width, "stroke-linecap": "round", "stroke-linejoin": "round",
+  }));
+}
