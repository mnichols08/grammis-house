+fn password_gate(state: &AppState, req: &Request, name: &str, session: &auth::Session) -> Result<(), Response> {
+    if password_required(state, session)?
+        && !matches!((req.method.as_str(), name), ("GET", "session") | ("POST", "logout") | ("POST", "change-password"))
+    {
+        return Err(Response::error(403, "Choose your own password before continuing."));
+    }
+    Ok(())
+}
+
+fn change_password(state: &AppState, req: &Request, session: &auth::Session) -> Response {
+    if let Err(r) = require_json(req) { return r; }
+    let body: Json = match serde_json::from_slice(&req.body) {
+        Ok(body) => body,
+        Err(_) => return Response::error(400, "Invalid JSON"),
+    };
+    let Some(password) = body.get("newPassword").and_then(Json::as_str) else {
+        return Response::error(400, "Enter a new password.");
+    };
+    let _guard = lock(&state.build);
+    let config = site::load_config(&state.root).unwrap_or_default();
+    let path = state.root.join(&config.admin.users_file);
+    let mut users = match Users::load(&path) {
+        Ok(users) => users,
+        Err(_) => return Response::error(503, "Unable to read sign-in settings."),
+    };
+    let Some(user) = users.find(&session.user) else {
+        return Response::error(401, "Session ended; sign in again");
+    };
+    if user.hash != session.credential || !user.must_change_password {
+        return Response::error(401, "Session ended; sign in again");
+    }
+    if auth::verify_password(&user.hash, password) {
+        return Response::error(422, "Choose a different password from the temporary one.");
+    }
+    if let Err(error) = users.set(&session.user, password) {
+        return Response::error(422, &error);
+    }
+    let ttl = Duration::from_secs(u64::from(config.admin.session_hours.clamp(1, 24 * 30)) * 3600);
+    let (token, next) = match lock(&state.sessions).create(&session.user, &users.find(&session.user).unwrap().hash, ttl) {
+        Ok(next) => next,
+        Err(_) => return Response::error(503, "Unable to start a new session. Try again."),
+    };
+    if users.save(&path).is_err() {
+        lock(&state.sessions).remove(&token);
+        return Response::error(503, "Unable to save your password. Try again.");
+    }
+    if let Some(old) = req.cookie(SESSION_COOKIE) { lock(&state.sessions).remove(old); }
+    Response::json(200, &json!({ "user": session.user, "csrf": next.csrf }))
+        .with_header("Set-Cookie", &session_cookie(&token, ttl.as_secs(), config.admin.secure_cookies))
+}
