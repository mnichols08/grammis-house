+/** A temporary password grants access only to this screen until it is replaced. */
+export async function showPasswordSetup(container, api, { replace = false } = {}) {
+  await use("text-field", "action-button", "alert-banner");
+  return new Promise((resolve) => {
+    const problem = h("div", { class: "studio-problem", "aria-live": "assertive" });
+    const password = h("text-field", { label: "Your new password", type: "password", name: "newPassword", autocomplete: "new-password", required: true });
+    const repeat = h("text-field", { label: "Repeat your new password", type: "password", name: "repeatPassword", autocomplete: "new-password", required: true });
+    const button = h("action-button", { type: "submit", size: "lg" }, "Save my password");
+    const form = h("form", { class: "studio-signin-form", "aria-label": "Choose your password", novalidate: true },
+      h("h1", { class: "studio-title", text: "Choose your own password" }),
+      h("p", { class: "studio-lede", text: "Choose a new password with at least 12 characters. You'll use it the next time you sign in." }),
+      problem, password, repeat, button);
+    form.addEventListener("submit", async (event) => {
+      event.preventDefault();
+      if (!password.value || password.value !== repeat.value) {
+        problem.replaceChildren(h("alert-banner", { variant: "danger", heading: "Check your password" }, "Enter the same new password in both boxes."));
+        return;
+      }
+      button.loading = true;
+      try {
+        const reply = await api.post("change-password", { newPassword: password.value });
+        api.csrf = reply.csrf;
+        password.value = "";
+        repeat.value = "";
+        resolve();
+      } catch (error) {
+        problem.replaceChildren(h("alert-banner", { variant: "danger", heading: "Password not saved" }, error.message));
+      } finally {
+        button.loading = false;
+      }
+    });
+    if (replace) container.replaceWith(form);
+    else container.replaceChildren(h("main", { class: "studio-signin" }, form));
+    form.querySelector("input")?.focus();
+  });
+}
