+++ b/web/studio/screens/fridge.js
@@ -0,0 +1,158 @@
+// Fridge: the drawings the family makes for the fridge on her site's fridge page wait here
+// until she puts them up, and she can take one down again (it's kept, never deleted). She tidies the
+// letter magnets back to how she started them from here too. Nothing on her site can do any of this.
+// A drawing is drawn from its strokes with createElementNS: lines in the pad's crayons, nothing else.
+import { fill, h, toast } from "../parts/dom.js";
+import { use } from "../zubra.js";
+import { ask } from "../parts/dialogs.js";
+import { say } from "../parts/words.js";
+
+const NS = "http://www.w3.org/2000/svg";
+const PAPER = 300;
+
+/** A drawing as an SVG, described for screen readers by `label`. Exported for tests. */
+export function drawPicture(drawing, label = "A drawing") {
+  const el = (name, attributes = {}) => {
+    const node = document.createElementNS(NS, name);
+    for (const [key, value] of Object.entries(attributes)) node.setAttribute(key, String(value));
+    return node;
+  };
+  const svg = el("svg", { viewBox: `0 0 ${PAPER} ${PAPER}`, role: "img", class: "studio-fridge-picture" });
+  const title = el("title");
+  title.textContent = label;
+  svg.append(title, el("rect", { width: PAPER, height: PAPER, fill: "#fffdf8" }));
+  for (const stroke of drawing?.strokes || []) {
+    const p = Array.isArray(stroke.p) ? stroke.p.map(Number) : [];
+    if (p.length === 2) {
+      svg.append(el("circle", { cx: p[0], cy: p[1], r: Number(stroke.s) / 2, fill: stroke.c }));
+      continue;
+    }
+    const points = [];
+    for (let i = 0; i + 1 < p.length; i += 2) points.push(`${p[i]},${p[i + 1]}`);
+    svg.append(el("polyline", { points: points.join(" "), fill: "none", stroke: stroke.c, "stroke-width": Number(stroke.s), "stroke-linecap": "round", "stroke-linejoin": "round" }));
+  }
+  return svg;
+}
+
+/** The top line, in her words. Exported for tests. */
+export function fridgeHeadline(waiting = [], up = []) {
+  if (waiting.length === 1) return "1 drawing is waiting for you";
+  if (waiting.length) return `${waiting.length} drawings are waiting for you`;
+  return up.length ? "No new drawings. Here's what's on your fridge" : "No drawings yet";
+}
+
+export async function createFridge({ api }) {
+  await use("action-button", "alert-banner", "empty-state", "skeleton-block");
+  let state = null;
+  const busy = new Set();
+  const heading = h("h2", { id: "studio-fridge-h", class: "studio-question", tabindex: "-1" });
+  const banner = h("div", { class: "studio-banner", "aria-live": "polite" });
+  const waitingList = h("ul", { class: "studio-gift-list", "aria-labelledby": "studio-fridge-waiting-h", "aria-busy": "true" }, h("li", {}, h("skeleton-block", { lines: 3 })));
+  const upList = h("ul", { class: "studio-gift-list", "aria-labelledby": "studio-fridge-up-h" });
+  const upNote = h("p", { class: "studio-help" });
+  const tidyButton = h("action-button", { variant: "secondary", onClick: () => tidy() }, "Tidy the fridge");
+  const element = h("section", { class: "studio-page studio-gifts", "aria-labelledby": "studio-fridge-h" },
+    h("div", { class: "studio-today" }, heading,
+      h("p", { class: "studio-lede", text: "The family draws these for the fridge on your site. Nobody sees one until you put it up." })),
+    banner,
+    h("section", { class: "studio-section", "aria-labelledby": "studio-fridge-waiting-h" },
+      h("h3", { id: "studio-fridge-waiting-h", text: "Waiting for you" }), waitingList),
+    h("section", { class: "studio-section", "aria-labelledby": "studio-fridge-up-h" },
+      h("h3", { id: "studio-fridge-up-h", text: "On your fridge now" }), upNote, upList),
+    h("section", { class: "studio-section", "aria-labelledby": "studio-fridge-letters-h" },
+      h("h3", { id: "studio-fridge-letters-h", text: "The letters" }),
+      h("p", { class: "studio-help", text: "Anyone can move the letter magnets. If someone spells something you'd rather not see, tidy the fridge: every letter goes back where it started." }),
+      tidyButton));
+
+  const trouble = (title, error) => banner.replaceChildren(h("alert-banner", { variant: "danger", heading: title },
+    error.status === 0 || !error.status ? "Check your connection and try again. Nothing is lost." : "Your fridge couldn't be reached just now. Nothing is lost; try again in a minute.",
+    error.status ? h("details", { class: "studio-help" }, h("summary", { text: say("common.forHelper") }), h("p", { class: "studio-mono", text: `${error.status}: ${error.message}` })) : null));
+
+  const label = (d) => (d.by ? `A drawing by ${d.by}` : "A drawing with no name on it");
+
+  function row(drawing, actions) {
+    const body = h("div", { class: "studio-gift-body" },
+      h("h4", { class: "studio-gift-from", tabindex: "-1", text: drawing.by || "No name on it" }),
+      drawing.createdAt ? h("p", { class: "studio-help", text: `Sent ${new Date(drawing.createdAt).toLocaleDateString(undefined, { month: "long", day: "numeric" })}` }) : null,
+      ...actions.map(([text, run, variant]) => h("action-button", { variant, size: "sm", onClick: () => run(drawing) }, text)));
+    return h("li", { class: "studio-gift studio-fridge-drawing", "data-id": drawing.id }, drawPicture(drawing.drawing, label(drawing)), body);
+  }
+
+  function draw() {
+    heading.textContent = fridgeHeadline(state.waiting, state.up);
+    waitingList.removeAttribute("aria-busy");
+    if (state.waiting.length) fill(waitingList, ...state.waiting.map((d) => row(d, [["Put it on the fridge", putUp, "primary"], ["Not this one", setAside, "ghost"]])));
+    else fill(waitingList, h("li", {}, h("empty-state", { heading: "Nothing waiting" }, "When someone draws you a picture for your fridge, it shows up here first.")));
+    upNote.textContent = `Up to ${state.most} hang at once. Putting up another takes down the one that's been up longest.`;
+    if (state.up.length) fill(upList, ...state.up.map((d) => row(d, [["Take it down", takeDown, "secondary"]])));
+    else fill(upList, h("li", { class: "studio-help", text: "None yet." }));
+  }
+
+  async function act(drawing, action, words) {
+    if (busy.has(drawing.id)) return;
+    busy.add(drawing.id);
+    try {
+      const reply = await api.post(`fridge/${drawing.id}/${action}`, {});
+      state = { ...state, ...reply };
+      banner.replaceChildren();
+      draw();
+      toast(words);
+    } catch (error) {
+      trouble("That didn't work", error);
+    } finally {
+      busy.delete(drawing.id);
+    }
+  }
+  const putUp = (d) => act(d, "up", `${d.by ? `${d.by}'s drawing` : "The drawing"} is on your fridge.`);
+  const takeDown = (d) => act(d, "down", "Taken down. It's kept, never deleted.");
+  async function setAside(d) {
+    const choice = await ask({
+      heading: "Leave this one off the fridge?",
+      text: "Nobody will see it. It's kept, and you can still find it later.",
+      choices: [{ label: "Leave it off", value: "off" }, { label: "Keep it waiting", value: "keep", variant: "secondary" }],
+    });
+    if (choice === "off") act(d, "down", "Left off the fridge.");
+  }
+
+  async function tidy() {
+    const choice = await ask({
+      heading: "Tidy the fridge?",
+      text: "Every letter goes back where it started. The drawings stay where they are.",
+      choices: [{ label: "Tidy it", value: "tidy" }, { label: "Leave it", value: "keep", variant: "secondary" }],
+    });
+    if (choice !== "tidy") return;
+    try {
+      await api.post("fridge/tidy", {});
+      toast("The letters are back where you started them.");
+    } catch (error) {
+      trouble("The fridge didn't tidy", error);
+    }
+  }
+
+  async function load() {
+    try {
+      state = await api.get("fridge/list");
+      banner.replaceChildren();
+      draw();
+    } catch (error) {
+      waitingList.removeAttribute("aria-busy");
+      fill(waitingList);
+      trouble("Your fridge didn't load", error);
+      banner.firstChild?.append(h("action-button", { variant: "secondary", onClick: load }, "Try again"));
+    }
+  }
+
+  return {
+    title: "Fridge",
+    element,
+    load,
+    reload: load,
+    focus: () => heading.focus(),
+    get palette() {
+      return [{ id: "tidy", label: "Tidy the fridge", group: "Fridge" }];
+    },
+    command(id) {
+      if (id === "tidy") tidy();
+    },
+  };
+}
