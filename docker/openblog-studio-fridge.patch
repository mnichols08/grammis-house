index 0000000..449e19d
--- /dev/null
+++ b/crates/openblog-cli/src/admin/fridge.rs
@@ -0,0 +1,365 @@
+//! Admin routes for the fridge: the drawings the family makes for the fridge on her site wait here
+//! until she puts them up, and she tidies the letter magnets from here.
+//!
+//! Like gifts, the fridge is optional and off by default. It lives in the site's family service,
+//! which Admin reaches only from this server, with the endpoint and key from the environment of the
+//! process running Admin (`OPENBLOG_FRIDGE_ENDPOINT`, `OPENBLOG_FRIDGE_ADMIN_KEY`), never from
+//! `openblog.json`, the repository or a response. Unset or invalid, and every route but `status` is
+//! a 404 and nothing is sent anywhere.
+//!
+//! Every route sits behind the session and, for a write, the CSRF check. A drawing is rebuilt from
+//! known fields before Studio sees it: strokes in the fridge's eight crayons and three pen sizes, every
+//! point a whole number on its 300 by 300 paper. Anything else, and the drawing is left out.
+
+use std::time::Duration;
+
+use super::social::{is_uuid, text, valid_endpoint};
+use super::*;
+
+pub(super) const MAX_FRIDGE_REQUEST_BYTES: usize = 256;
+const MAX_REPLY_BYTES: u64 = 8 * 1024 * 1024;
+const MIN_KEY_CHARS: usize = 32;
+/// The crayons and pens the fridge's drawing pad offers (family/lib/fridge.js).
+const INKS: [&str; 8] = [
+    "#1f2633", "#d7263d", "#1b6fd1", "#1f9d55", "#f2b600", "#f47b20", "#8e44c9", "#8b5a2b",
+];
+const PENS: [u64; 3] = [3, 7, 14];
+const PAPER: u64 = 300;
+const MAX_STROKES: usize = 150;
+const MAX_STROKE_POINTS: usize = 500;
+const MAX_POINTS: usize = 9000;
+const MAX_LISTED: usize = 60;
+
+struct FridgeConfig {
+    endpoint: String,
+    key: String,
+}
+
+enum Configured {
+    Off,
+    Invalid(Vec<&'static str>),
+    On(FridgeConfig),
+}
+
+fn configuration(env: &dyn Fn(&str) -> Option<String>) -> Configured {
+    let endpoint = env("OPENBLOG_FRIDGE_ENDPOINT").unwrap_or_default();
+    let key = env("OPENBLOG_FRIDGE_ADMIN_KEY").unwrap_or_default();
+    if endpoint.trim().is_empty() && key.is_empty() {
+        return Configured::Off;
+    }
+    let mut problems = Vec::new();
+    let endpoint = valid_endpoint(&endpoint);
+    if endpoint.is_none() {
+        problems.push("OPENBLOG_FRIDGE_ENDPOINT");
+    }
+    if key.chars().count() < MIN_KEY_CHARS || key.chars().any(char::is_whitespace) {
+        problems.push("OPENBLOG_FRIDGE_ADMIN_KEY");
+    }
+    match (endpoint, problems.is_empty()) {
+        (Some(endpoint), true) => Configured::On(FridgeConfig { endpoint, key }),
+        _ => Configured::Invalid(problems),
+    }
+}
+
+fn process_env(name: &str) -> Option<String> {
+    std::env::var(name).ok()
+}
+
+/// Whether the fridge is set up and valid here. Only then does Studio show Fridge.
+pub(super) fn is_configured() -> bool {
+    matches!(configuration(&process_env), Configured::On(_))
+}
+
+fn bad_reply() -> Response {
+    Response::error(502, "The fridge service sent a reply Admin could not use")
+}
+
+fn refusal(status: u16, body: &Json) -> Response {
+    let code = body
+        .get("error")
+        .and_then(Json::as_str)
+        .filter(|c| c.len() <= 40 && c.bytes().all(|b| b.is_ascii_lowercase() || b == b'-'));
+    let (out, message) = match (status, code) {
+        (401, _) => (
+            502,
+            "The fridge service did not accept Admin's key; check OPENBLOG_FRIDGE_ADMIN_KEY",
+        ),
+        (404, Some("not-enabled")) => (
+            502,
+            "The fridge is not switched on where the family service runs",
+        ),
+        (404, _) => (404, "That drawing is no longer there; reload"),
+        _ => (502, "The fridge service failed; try again"),
+    };
+    Response::json(out, &json!({ "error": message, "code": code }))
+}
+
+fn hosted(config: &FridgeConfig, method: &str, path: &str) -> Result<Json, Response> {
+    let agent: ureq::Agent = ureq::Agent::config_builder()
+        .timeout_global(Some(Duration::from_secs(30)))
+        .max_redirects(0)
+        .http_status_as_error(false)
+        .user_agent(concat!("open.blog-admin/", env!("CARGO_PKG_VERSION")))
+        .build()
+        .into();
+    let url = format!("{}/admin/{}", config.endpoint, path);
+    let authorization = format!("Bearer {}", config.key);
+    let result = if method == "GET" {
+        agent
+            .get(&url)
+            .header("Authorization", &authorization)
+            .call()
+    } else {
+        agent
+            .post(&url)
+            .header("Authorization", &authorization)
+            .header("Content-Type", "application/json")
+            .send("{}".as_bytes())
+    };
+    let mut response = match result {
+        Ok(response) => response,
+        Err(ureq::Error::Timeout(_)) => {
+            return Err(Response::error(504, "The fridge service timed out"))
+        }
+        Err(_) => {
+            return Err(Response::error(
+                502,
+                "The fridge service could not be reached",
+            ))
+        }
+    };
+    let status = response.status().as_u16();
+    let bytes = response
+        .body_mut()
+        .with_config()
+        .limit(MAX_REPLY_BYTES)
+        .read_to_vec()
+        .map_err(|_| bad_reply())?;
+    let value: Json = serde_json::from_slice(&bytes).map_err(|_| bad_reply())?;
+    if status >= 300 {
+        return Err(refusal(status, &value));
+    }
+    Ok(value)
+}
+
+fn instant(value: &Json) -> Option<Json> {
+    let s = value.as_str()?;
+    let ok = (20..=40).contains(&s.len())
+        && s.as_bytes()[4] == b'-'
+        && s.as_bytes()[10] == b'T'
+        && s.bytes()
+            .all(|b| b.is_ascii_digit() || b"-:T.Z+".contains(&b));
+    ok.then(|| Json::String(s.to_string()))
+}
+
+/// A drawing rebuilt from its strokes, or None when anything in it is not a stroke the pad makes.
+fn project_strokes(value: &Json) -> Option<Json> {
+    let strokes = value.get("strokes")?.as_array()?;
+    if strokes.is_empty() || strokes.len() > MAX_STROKES {
+        return None;
+    }
+    let mut total = 0;
+    let mut out = Vec::with_capacity(strokes.len());
+    for stroke in strokes {
+        let ink = stroke.get("c")?.as_str().filter(|c| INKS.contains(c))?;
+        let pen = stroke.get("s")?.as_u64().filter(|s| PENS.contains(s))?;
+        let points = stroke.get("p")?.as_array()?;
+        if points.len() < 2 || points.len() % 2 != 0 || points.len() / 2 > MAX_STROKE_POINTS {
+            return None;
+        }
+        let points: Option<Vec<u64>> = points
+            .iter()
+            .map(|n| n.as_u64().filter(|n| *n <= PAPER))
+            .collect();
+        let points = points?;
+        total += points.len() / 2;
+        out.push(json!({ "c": ink, "s": pen, "p": points }));
+    }
+    (total <= MAX_POINTS).then(|| json!({ "strokes": out }))
+}
+
+fn project_drawing(value: &Json) -> Option<Json> {
+    let id = value.get("id")?.as_str().filter(|id| is_uuid(id))?;
+    let mut drawing = json!({
+        "id": id,
+        "by": value.get("by").and_then(|b| text(b, 40)).unwrap_or_default(),
+        "drawing": project_strokes(value.get("drawing")?)?,
+    });
+    if let Some(at) = value.get("createdAt").and_then(instant) {
+        drawing["createdAt"] = at;
+    }
+    Some(drawing)
+}
+
+/// The two shelves Studio shows, each drawing rebuilt; one that can't be is left out, never passed on.
+fn shelves(reply: &Json) -> Result<Json, Response> {
+    let list = |name: &str| -> Result<Vec<Json>, Response> {
+        Ok(reply
+            .get(name)
+            .and_then(Json::as_array)
+            .ok_or_else(bad_reply)?
+            .iter()
+            .take(MAX_LISTED)
+            .filter_map(project_drawing)
+            .collect())
+    };
+    Ok(json!({
+        "waiting": list("waiting")?,
+        "up": list("up")?,
+        "most": reply.get("most").and_then(Json::as_u64).filter(|n| (1..=60).contains(n)).unwrap_or(8),
+    }))
+}
+
+fn empty_body(req: &Request) -> Result<(), Response> {
+    let body: Json = if req.body.is_empty() {
+        json!({})
+    } else {
+        serde_json::from_slice(&req.body)
+            .map_err(|_| Response::error(400, "The request is not valid JSON"))?
+    };
+    match body.as_object() {
+        Some(object) if object.is_empty() => Ok(()),
+        _ => Err(Response::error(
+            400,
+            "The request has a field this route does not take",
+        )),
+    }
+}
+
+pub(super) fn route(req: &Request, name: &str) -> Response {
+    route_with(&process_env, req, name)
+}
+
+pub(super) fn route_with(
+    env: &dyn Fn(&str) -> Option<String>,
+    req: &Request,
+    name: &str,
+) -> Response {
+    let config = match configuration(env) {
+        Configured::On(config) => config,
+        Configured::Off if name == "status" && req.method == "GET" => {
+            return Response::json(200, &json!({ "enabled": false, "state": "off" }))
+        }
+        Configured::Invalid(problems) if name == "status" && req.method == "GET" => {
+            return Response::json(
+                200,
+                &json!({ "enabled": false, "state": "invalid", "problems": problems }),
+            )
+        }
+        _ => return Response::error(404, "The fridge is not set up"),
+    };
+    if req.method != "GET" {
+        if let Err(response) = require_json(req) {
+            return response;
+        }
+    }
+    let parts: Vec<&str> = name.split('/').collect();
+    let result = match (req.method.as_str(), parts.as_slice()) {
+        ("GET", ["status"]) => Ok(json!({ "enabled": true, "state": "on" })),
+        ("GET", ["list"]) => hosted(&config, "GET", "list").and_then(|reply| shelves(&reply)),
+        ("POST", ["tidy"]) => empty_body(req)
+            .and_then(|_| hosted(&config, "POST", "tidy"))
+            .map(|_| json!({ "ok": true })),
+        ("POST", [id, action @ ("up" | "down")]) if is_uuid(id) => empty_body(req)
+            .and_then(|_| hosted(&config, "POST", &format!("{id}/{action}")))
+            .and_then(|reply| shelves(&reply)),
+        _ => return Response::error(404, "Unknown API route"),
+    };
+    match result {
+        Ok(value) => Response::json(200, &value),
+        Err(response) => response,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn env(pairs: &'static [(&'static str, &'static str)]) -> impl Fn(&str) -> Option<String> {
+        move |name| {
+            pairs
+                .iter()
+                .find(|(k, _)| *k == name)
+                .map(|(_, v)| v.to_string())
+        }
+    }
+
+    #[test]
+    fn the_fridge_is_off_until_both_variables_are_right() {
+        assert!(matches!(configuration(&env(&[])), Configured::Off));
+        let Configured::Invalid(problems) = configuration(&env(&[
+            (
+                "OPENBLOG_FRIDGE_ENDPOINT",
+                "https://family.example/api/fridge",
+            ),
+            ("OPENBLOG_FRIDGE_ADMIN_KEY", "short"),
+        ])) else {
+            panic!("a short key is not a key");
+        };
+        assert_eq!(problems, ["OPENBLOG_FRIDGE_ADMIN_KEY"]);
+        assert!(matches!(
+            configuration(&env(&[
+                (
+                    "OPENBLOG_FRIDGE_ENDPOINT",
+                    "https://family.example/api/fridge"
+                ),
+                (
+                    "OPENBLOG_FRIDGE_ADMIN_KEY",
+                    "ffffffffffffffffffffffffffffffffffffffff"
+                )
+            ])),
+            Configured::On(_)
+        ));
+    }
+
+    #[test]
+    fn a_drawing_reaches_studio_only_as_strokes_from_the_pad() {
+        let good = json!({ "id": "0b6f6c55-3c33-4a4b-9a77-6f7cbbd3e0a1", "by": "Jimmy", "createdAt": "2026-12-01T15:00:00.000000+00:00",
+            "drawing": { "strokes": [{ "c": "#d7263d", "s": 7, "p": [10, 10, 200, 200] }] }, "extra": "<script>" });
+        let shown = project_drawing(&good).unwrap();
+        assert_eq!(
+            shown,
+            json!({ "id": "0b6f6c55-3c33-4a4b-9a77-6f7cbbd3e0a1", "by": "Jimmy", "createdAt": "2026-12-01T15:00:00.000000+00:00",
+            "drawing": { "strokes": [{ "c": "#d7263d", "s": 7, "p": [10, 10, 200, 200] }] } })
+        );
+        for bad in [
+            json!({ "strokes": [{ "c": "url(javascript:x)", "s": 7, "p": [1, 1] }] }),
+            json!({ "strokes": [{ "c": "#d7263d", "s": 8, "p": [1, 1] }] }),
+            json!({ "strokes": [{ "c": "#d7263d", "s": 7, "p": [1, 301] }] }),
+            json!({ "strokes": [{ "c": "#d7263d", "s": 7, "p": [1, 2, 3] }] }),
+            json!({ "strokes": [{ "c": "#d7263d", "s": 7, "p": [1.5, 2] }] }),
+            json!({ "strokes": [] }),
+        ] {
+            let mut drawing = good.clone();
+            drawing["drawing"] = bad.clone();
+            assert!(project_drawing(&drawing).is_none(), "{bad}");
+        }
+        let reply = json!({ "waiting": [good, { "id": "not-a-uuid", "drawing": {} }], "up": [], "most": 8 });
+        let shelves = shelves(&reply).unwrap();
+        assert_eq!(
+            shelves["waiting"].as_array().unwrap().len(),
+            1,
+            "one it can't rebuild is left out"
+        );
+    }
+
+    #[test]
+    fn nothing_is_sent_anywhere_when_the_fridge_is_not_set_up() {
+        let req = Request {
+            method: "GET".into(),
+            path: "/admin/api/fridge/list".into(),
+            ..Default::default()
+        };
+        assert_eq!(route_with(&env(&[]), &req, "list").status, 404);
+        let status = route_with(
+            &env(&[]),
+            &Request {
+                method: "GET".into(),
+                path: "/admin/api/fridge/status".into(),
+                ..Default::default()
+            },
+            "status",
+        );
+        assert_eq!(status.status, 200);
+    }
+}
