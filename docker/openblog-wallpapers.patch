+/// The site's wallpapers, from a `wallpapers.json`: `{ "version": 1, "wallpapers": [{ "id",
+/// "label", "about", "svg" }] }`. Refused whole when any one is not a plain tile.
+pub fn parse_wallpapers(text: &str) -> Result<Vec<Wallpaper>, String> {
+    let value: Value =
+        serde_json::from_str(text).map_err(|error| format!("wallpapers.json: {error}"))?;
+    if value["version"] != json!(1) {
+        return Err("wallpapers.json must be version 1".into());
+    }
+    let Some(list) = value["wallpapers"].as_array() else {
+        return Err("wallpapers.json has no `wallpapers` list".into());
+    };
+    if list.len() > MAX_WALLPAPERS {
+        return Err(format!(
+            "wallpapers.json has more than {MAX_WALLPAPERS} wallpapers"
+        ));
+    }
+    let mut seen = std::collections::HashSet::new();
+    let mut out = Vec::with_capacity(list.len());
+    for item in list {
+        let text = |key: &str, max: usize| -> Option<String> {
+            item[key]
+                .as_str()
+                .map(str::trim)
+                .filter(|t| !t.is_empty() && one_line(t) && t.chars().count() <= max)
+                .map(str::to_string)
+        };
+        let id = text("id", 40)
+            .filter(|id| wallpaper_id(id) && id != WALLPAPER_KEEP && id != WALLPAPER_NONE);
+        let (Some(id), Some(label), Some(about), Some(svg)) = (
+            id,
+            text("label", MAX_LABEL_CHARS),
+            text("about", 160),
+            item["svg"]
+                .as_str()
+                .map(str::to_string)
+                .filter(|svg| plain_tile(svg)),
+        ) else {
+            return Err(format!(
+                "wallpapers.json: `{}` needs an id, a label, a few words about it, and a plain tile drawn in {{ink}}",
+                item["id"].as_str().unwrap_or("?")
+            ));
+        };
+        if !seen.insert(id.clone()) {
+            return Err(format!("wallpapers.json: `{id}` is there twice"));
+        }
+        out.push(Wallpaper {
+            id,
+            label,
+            about,
+            svg,
+        });
+    }
+    Ok(out)
+}
+
+/// A tile filled with `ink` and laid on at `strength`, as a CSS `url()` value.
+fn wallpaper_url(svg: &str, ink: &str, strength: &str) -> String {
+    let filled = svg.replace("{ink}", ink);
+    let open_end = filled.find('>').map(|at| at + 1).unwrap_or(0);
+    let close = filled.rfind("</svg>").unwrap_or(filled.len());
+    let laid = format!(
+        "{}<g opacity='{strength}'>{}</g>{}",
+        &filled[..open_end],
+        &filled[open_end..close],
+        &filled[close..]
+    );
+    let mut encoded = String::with_capacity(laid.len() * 2);
+    for byte in laid.bytes() {
+        if byte.is_ascii_alphanumeric() || b" =:/,;'-._~".contains(&byte) {
+            encoded.push(byte as char);
+        } else {
+            encoded.push_str(&format!("%{byte:02X}"));
+        }
+    }
+    format!("url(\"data:image/svg+xml,{encoded}\")")
+}
+
+/// The tile's own size (`width='48' height='48'`) as a background size.
+fn wallpaper_size(svg: &str) -> String {
+    let number = |name: &str| -> Option<u32> {
+        let at = svg.find(&format!("{name}='"))? + name.len() + 2;
+        svg[at..]
+            .split('\'')
+            .next()?
+            .parse()
+            .ok()
+            .filter(|n| (4..=512).contains(n))
+    };
+    match (number("width"), number("height")) {
+        (Some(w), Some(h)) => format!("{w}px {h}px"),
+        _ => "auto".into(),
+    }
+}
