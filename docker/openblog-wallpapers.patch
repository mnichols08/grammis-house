+const PAPERS: &str = r#"{"version":1,"wallpapers":[
+  {"id":"gingham","label":"Gingham","about":"a picnic-blanket check","svg":"<svg xmlns='http://www.w3.org/2000/svg' width='32' height='32' viewBox='0 0 32 32'><rect width='16' height='32' fill='{ink}'/></svg>"}]}"#;
+
+#[test]
+fn a_described_background_is_one_of_the_sites_wallpapers_drawn_in_the_looks_colours() {
+    let _env = quiz_env();
+    let _key = EnvRestore::capture("OPENBLOG_LESSONS_API_KEY");
+    let f = fixture("theme-draft-wallpaper");
+    let session = login_ok(&f);
+    std::env::set_var("OPENBLOG_LESSONS_API_KEY", "theme-secret");
+    fs::write(f.dir.join("themes/paper/wallpapers.json"), PAPERS).unwrap();
+    let mut chosen = draft();
+    chosen["wallpaper"] = json!("gingham");
+
+    // The site's wallpapers reach the provider as ids and words; the answer is drawn by the engine.
+    let (endpoint, captured, provider) = capturing_provider(chosen.to_string());
+    set_quiz_endpoint(&f, &endpoint);
+    let response = post(
+        &f,
+        &session,
+        "theme-draft",
+        json!({ "confirmed": true, "description": "blue gingham behind everything", "base": "paper" }),
+    );
+    assert_eq!(
+        response.status,
+        200,
+        "{}",
+        String::from_utf8_lossy(&response.body)
+    );
+    provider.join().unwrap();
+    let outbound = captured.recv().unwrap();
+    assert_eq!(outbound["choices"]["wallpaper"][2]["id"], "gingham");
+    assert!(
+        !outbound.to_string().contains("<svg"),
+        "the provider never sees a picture"
+    );
+    let answer = body_json(&response);
+    assert_eq!(
+        answer["wallpaper"],
+        json!({ "id": "gingham", "label": "Gingham" })
+    );
+    let tokens = &answer["theme"]["tokens"];
+    assert!(tokens["decorPattern"]
+        .as_str()
+        .unwrap()
+        .starts_with("url(\"data:image/svg+xml,"));
+    assert!(
+        tokens["decorPatternDark"].as_str().unwrap().contains("%23"),
+        "drawn in a colour"
+    );
+    assert_eq!(tokens["decorPatternSize"], "32px 32px");
+
+    // A wallpaper the site doesn't have is refused, from the provider and from the editor.
+    let mut unknown = draft();
+    unknown["wallpaper"] = json!("tartan");
+    let (endpoint, _captured, provider) = capturing_provider(unknown.to_string());
+    set_quiz_endpoint(&f, &endpoint);
+    let refused = post(
+        &f,
+        &session,
+        "theme-draft",
+        json!({ "confirmed": true, "description": "tartan please", "base": "paper" }),
+    );
+    provider.join().unwrap();
+    assert_eq!(refused.status, 502);
+    let preview = post(
+        &f,
+        &session,
+        "theme-draft/preview",
+        json!({ "draft": unknown, "base": "paper" }),
+    );
+    assert_eq!(preview.status, 422);
+    assert_eq!(body_json(&preview)["field"], "wallpaper");
+
+    // Saved, the new look carries the wallpaper for light and for dark; "none" is a plain page.
+    let saved = post(
+        &f,
+        &session,
+        "theme-draft/save",
+        json!({ "draft": chosen, "base": "paper" }),
+    );
+    assert_eq!(
+        saved.status,
+        201,
+        "{}",
+        String::from_utf8_lossy(&saved.body)
+    );
+    let name = body_json(&saved)["name"].as_str().unwrap().to_string();
+    let written: Json = serde_json::from_str(
+        &fs::read_to_string(f.dir.join(format!("themes/{name}/theme.json"))).unwrap(),
+    )
+    .unwrap();
+    assert_eq!(written["extends"], "paper");
+    assert!(written["tokens"]["decorPattern"]
+        .as_str()
+        .unwrap()
+        .contains("opacity='0.14'"));
+    assert!(written["tokens"]["decorPatternDark"]
+        .as_str()
+        .unwrap()
+        .contains("opacity='0.16'"));
+    let mut plain = draft();
+    plain["label"] = json!("Plain Kitchen");
+    plain["wallpaper"] = json!("none");
+    let saved = post(
+        &f,
+        &session,
+        "theme-draft/save",
+        json!({ "draft": plain, "base": "paper" }),
+    );
+    let name = body_json(&saved)["name"].as_str().unwrap().to_string();
+    let written: Json = serde_json::from_str(
+        &fs::read_to_string(f.dir.join(format!("themes/{name}/theme.json"))).unwrap(),
+    )
+    .unwrap();
+    assert_eq!(written["tokens"]["decorPattern"], "none");
+    let _ = fs::remove_dir_all(&f.dir);
+}
