+/// The wallpaper a draft may choose besides the site's own: `theme` keeps what the theme it extends
+/// hangs behind the page, `none` is a plain page. Any other choice is the `id` of one of the site's
+/// wallpapers (its themes' `wallpapers.json`, see [`parse_wallpapers`]).
+pub const WALLPAPER_KEEP: &str = "theme";
+pub const WALLPAPER_NONE: &str = "none";
+/// How strongly a wallpaper is laid on: faint, so the words always win.
+pub const WALLPAPER_LIGHT_STRENGTH: &str = "0.14";
+pub const WALLPAPER_DARK_STRENGTH: &str = "0.16";
+/// The most wallpapers a site offers, and the largest tile.
+pub const MAX_WALLPAPERS: usize = 60;
+pub const MAX_WALLPAPER_BYTES: usize = 8 * 1024;
+
+/// One of the site's wallpapers: a repeating tile drawn in a single ink, written `{ink}`, which the
+/// engine fills with the drafted look's accent. The writing helper only ever picks its `id`; it
+/// never draws one, so nothing it writes can become a picture (ADR 0410 keeps decorations out of
+/// drafts for that reason; a closed list keeps that true).
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Wallpaper {
+    pub id: String,
+    pub label: String,
+    /// A few plain words on what it looks like, for the writing helper to match a description to.
+    pub about: String,
+    pub svg: String,
+}
+
+fn wallpaper_id(id: &str) -> bool {
+    (1..=40).contains(&id.len())
+        && id
+            .bytes()
+            .all(|b| b.is_ascii_lowercase() || b.is_ascii_digit() || b == b'-')
+        && !id.starts_with('-')
+        && !id.ends_with('-')
+}
+
+/// A tile is plain shapes: nothing that runs, loads, links or styles. The list is the site's own
+/// file, like a theme, but this keeps a slip in it from reaching a page.
+fn plain_tile(svg: &str) -> bool {
+    let lower = svg.to_ascii_lowercase();
+    let refused = [
+        "<script",
+        "<style",
+        "<foreignobject",
+        "<image",
+        "<use",
+        "<a ",
+        "<iframe",
+        "href",
+        "url(",
+        "javascript:",
+        "@import",
+        "<!",
+    ];
+    let handler = lower.match_indices("on").any(|(at, _)| {
+        let before = lower[..at].chars().last();
+        let rest = &lower[at + 2..];
+        let name_len = rest.bytes().take_while(u8::is_ascii_lowercase).count();
+        matches!(before, Some(c) if c.is_whitespace())
+            && name_len > 0
+            && rest[name_len..].trim_start().starts_with('=')
+    });
+    svg.len() <= MAX_WALLPAPER_BYTES
+        && lower.starts_with("<svg ")
+        && lower.trim_end().ends_with("</svg>")
+        && svg.contains("{ink}")
+        && !refused.iter().any(|word| lower.contains(word))
+        && !handler
+}
