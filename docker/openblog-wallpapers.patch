+fn site_wallpapers(state: &AppState, config: &SiteConfig, base: &str) -> Vec<Wallpaper> {
+    let themes_dir = state.root.join(&config.paths.themes);
+    let mut name = base.to_string();
+    for _ in 0..8 {
+        let folder = themes_dir.join(&name);
+        if let Ok(text) = fs::read_to_string(folder.join("wallpapers.json")) {
+            return parse_wallpapers(&text).unwrap_or_default();
+        }
+        let parent = fs::read_to_string(folder.join("theme.json"))
+            .ok()
+            .and_then(|text| serde_json::from_str::<Json>(&text).ok())
+            .and_then(|theme| theme["extends"].as_str().map(str::to_string));
+        match parent {
+            Some(parent) if !parent.is_empty() && !parent.contains(['/', '\\', '.']) => {
+                name = parent
+            }
+            _ => break,
+        }
+    }
+    Vec::new()
+}
