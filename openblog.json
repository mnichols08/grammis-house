  "home": {
    "heading": "From Grammi's kitchen",
    "intro": "",
    "showSeries": true
  },
  "share": {
    "enabled": true,
    "networks": [
      "facebook",
      "pinterest",
      "email"
    ]
  },
  "analytics": {
    "builtin": true,
    "showViews": true,
    "retentionDays": 400,
    "endpoint": "",
    "branch": "analytics",
    "bakeCounts": true
  },
  "engagement": {
    "enabled": true,
    "comments": true,
    "analytics": true,
    "endpoint": "https://grammis-house.up.railway.app/api",
    "feedback": false,
    "feedbackContact": ""
  },
  "snippets": {
    "head": "",
    "postFooter": "",
    "bodyEnd": ""
  },
  "relatedPosts": 3,
  "cdn": {
    "url": "",
    "paths": [
      "/assets/",
      "/themes/",
      "/images/"
    ],
    "version": "",
    "maxAge": 86400
  },
  "feeds": {
    "rss": true,
    "json": true,
    "sitemap": true,
    "llms": true,
    "portfolioSnapshot": false,
    "limit": 20,
    "fullContent": true
  },
  "seo": {
    "aiSearch": true,
    "aiTraining": false
  },
  "markdown": {
    "smartPunctuation": false,
    "headingAnchors": true,
    "embeds": true,
    "tocDepth": 3,
    "tocMinHeadings": 3
  },
  "code": {
    "highlight": null,
    "lineNumbers": null,
    "copyButton": true,
    "playgroundLink": true
  },
  "codeRunner": {
    "endpoint": "",
    "languages": []
  },
  "webSandbox": {
    "libraries": {}
  },
  "recipes": {
    "scaling": true,
    "checklists": true,
    "timers": true,
    "cookMode": true,
    "print": true,
    "jumpLink": true,
    "listing": true
  },
  "knowledgeChecks": {
    "provider": "anthropic",
    "generationEndpoint": "",
    "model": "claude-sonnet-5-5"
  },
  "paths": {
    "content": "content",
    "static": "static",
    "output": "dist",
    "themes": "themes",
    "web": "web"
  },
  "admin": {
    "usersFile": ".openblog/users.json",
    "sessionHours": 12,
    "secureCookies": false,
    "maxUploadMb": 10,
    "trustedProxies": [],
    "signInUrl": "https://grammis-house-admin.up.railway.app/admin/"
  },
  "publish": {
    "remote": "origin",
    "branch": "main",
    "auto": false,
    "includeDrafts": false,
    "paths": [
      "content",
      "static",
      "openblog.json",
      "themes",
      ".github"
    ],
    "pullFirst": true
  },
  "syndication": {
    "stateFile": ".openblog/syndication.json",
    "targets": {},
    "requireApproval": false,
    "approvalFile": ".openblog/distribution-approvals.json"
  },
  "redirectsFile": false,
