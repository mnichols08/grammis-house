<!--
  A postcard on the home page that asks the family to write in. Its button opens the reader's
  email with a note to Grammi already addressed; she puts her favorites on the Family wall.
  Nothing is sent through the site, so there's nothing to host and no account to make.

  email    where the notes go
  prompt   what the card asks ("Made one of my recipes? Tell me how it went!")
  button   the button's words
  subject  the email's subject line
-->
<script>
  const to = (email || '').trim()
  const link = to ? `mailto:${to}?subject=${encodeURIComponent(subject || 'A note for Grammi')}` : ''
</script>
<style>
  :host { display: block; }
  .postcard {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.4rem 1.2rem;
    align-items: center;
    max-width: 38rem;
    margin: 1.5rem auto;
    padding: 1.3rem 1.5rem 1.3rem 1.6rem;
    background:
      repeating-linear-gradient(-45deg, #c8343a 0 10px, #ffffff 10px 20px, #2b4f8a 20px 30px, #ffffff 30px 40px) border-box;
    border: 7px solid transparent;
    border-radius: 6px;
    box-shadow: 0 8px 18px -12px rgb(0 0 0 / 0.5);
    rotate: -0.6deg;
  }
  .postcard::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      repeating-linear-gradient(to bottom, transparent 0 1.9rem, color-mix(in srgb, var(--border, #d9d6cc) 70%, transparent) 1.9rem calc(1.9rem + 1px)),
      var(--card, #fffdf8);
  }
  .postcard > * { position: relative; z-index: 1; }
  .prompt {
    margin: 0;
    font-family: var(--ob-font-hand, cursive);
    font-size: 1.55rem;
    line-height: 1.25;
    color: var(--foreground, #1f2633);
  }
  .stamp {
    grid-row: span 2;
    width: 4.2rem;
    height: 5rem;
    padding: 0.35rem;
    background: var(--card, #fff);
    border: 2px dotted color-mix(in srgb, var(--primary, #a3172b) 60%, transparent);
    rotate: 4deg;
  }
  .stamp svg { width: 100%; height: 100%; display: block; }
  .send {
    justify-self: start;
    display: inline-block;
    padding: 0.45rem 1rem;
    border-radius: 999px;
    background: var(--primary, #a3172b);
    color: var(--primary-foreground, #fff);
    font-weight: 600;
    text-decoration: none;
  }
  .send:focus-visible { outline: 3px solid var(--ring, #f2c14e); outline-offset: 2px; }
  .send[hidden], .postcard[hidden] { display: none; }
  @media (max-width: 30rem) { .postcard { grid-template-columns: 1fr; } .stamp { display: none; } }
</style>
<family-mailbox email="" prompt="Made one of my recipes? Tell me how it turned out, and send a picture!" button="Write to Grammi" subject="A note for Grammi">
  <div class="postcard" hidden={!link}>
    <p class="prompt">{prompt}</p>
    <div class="stamp" aria-hidden="true">
      <svg viewBox="0 0 40 50">
        <rect width="40" height="50" fill="#f7efe0" />
        <path d="M6 40 20 12 34 40Z" fill="#2f6b3f" />
        <path d="M11 40 20 22 29 40Z" fill="#3f8a52" />
        <rect x="18" y="40" width="4" height="5" fill="#7a4a26" />
        <circle cx="20" cy="11" r="2.5" fill="#f2c14e" />
        <circle cx="31" cy="9" r="4" fill="#ffffff" stroke="#e0cdb0" />
      </svg>
    </div>
    <a class="send" href={link || '#'} hidden={!link}>{button}</a>
  </div>
</family-mailbox>
