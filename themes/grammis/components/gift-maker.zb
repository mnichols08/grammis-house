<!--
  Gifts under the tree: the wrapped boxes people have left, and the little form for leaving one.
  A gift is a note, or a card made here from a design, a few words and stickers. It stays wrapped
  until Christmas morning, when Grammi opens it in her own pages; nothing anyone writes is ever
  shown on the site.

  heading  the heading (default "Under the tree")
  shows    when it's on the page: "season" (from November 20 to January 6, the default) or "always"

  It talks to the family service that serves the page (family/ in this repository) through its own
  server functions, `look` and `leave`; on a copy of the site anywhere else it stays hidden.

  The boxes sit in a pile on the floor under the tree, each where its giver set it down. A place
  is only a wish: boxes are settled one after another in the order they came, and each is nudged
  until it overlaps its neighbours only so far, so no gift can bury another. A gift with no place
  (an older one) gets one worked out from its id, the same on every visit.

  The page shows only the boxes, and a name only when the giver chose that and Grammi allows it. The service decides whether the family password is asked for; this form asks unless
  the service says anyone may leave a gift. A card is still a design, words and stickers from
  fixed lists, drawn here the same way her pages draw it, with text nodes only. On top of that a
  guest can color the paper, draw, place words, drag stickers, and add a small photo.
-->
<script>
  import { onMount } from '@zubra/runtime'
  import { lookAtTree, leaveGift } from '../../../family/actions.js'

  // The family service's side (family/gifts.js). These two run on the server; the page only ever has
  // their addresses. `look` is the boxes and a form token; `leave` is one gift, from the form's fields.
  export async function look() {
    'use server'
    return lookAtTree()
  }
  export async function leave(formData, { request }) {
    'use server'
    return leaveGift(formData, request)
  }

  const WRAPS = [['red', 'Red'], ['green', 'Green'], ['gold', 'Gold'], ['blue', 'Blue'], ['plaid', 'Plaid'], ['stripes', 'Stripes']]
  const BOWS = [['gold', 'Gold'], ['red', 'Red'], ['green', 'Green'], ['white', 'White'], ['blue', 'Blue'], ['none', 'No bow']]
  const STICKER_NAMES = [['star', 'Star'], ['heart', 'Heart'], ['snowflake', 'Snowflake'], ['candy-cane', 'Candy cane'], ['bell', 'Bell'], ['mitten', 'Mitten'], ['cookie', 'Cookie'], ['ornament', 'Ornament'], ['holly', 'Holly'], ['gift', 'Gift']]
  const INKS = [['#1f2633', 'Ink'], ['#a11224', 'Red'], ['#1f4d2c', 'Pine'], ['#1f4f9a', 'Blue'], ['#f2c14e', 'Gold'], ['#ffffff', 'White'], ['#7a1020', 'Wine'], ['#5a3518', 'Brown']]
  const PAPERS = [['', 'The design'], ['#fffdf8', 'Cream'], ['#f7f3e8', 'Ivory'], ['#fff6f2', 'Blush'], ['#1f3a5f', 'Night'], ['#2f6b3f', 'Pine'], ['#a4643a', 'Ginger'], ['#2b2140', 'Plum']]
  const TEXT_SIZES = [18, 24, 32, 44]
  const PEN_SIZES = [[3, 'Thin'], [6, 'Medium'], [12, 'Thick']]
  // Where each sticker lands, in the order they're added: the corners first, then the edges.
  const SPOTS = [[6, 8], [94, 8], [6, 92], [94, 92], [50, 4], [50, 96], [4, 50], [96, 50]]

  // The same drawing Grammi's pages use for a card, so what a guest sees is what she opens.
  const NS = 'http://www.w3.org/2000/svg'
  const W = 600
  const H = 400
  const DESIGNS = {
    'snowy-night': { label: 'Snowy night', bg: '#1f3a5f', ink: '#ffffff', edge: '#9cc3e6', shapes: [['circle', { cx: 80, cy: 70, r: 4, fill: '#fff' }], ['circle', { cx: 520, cy: 60, r: 3, fill: '#fff' }], ['circle', { cx: 460, cy: 340, r: 5, fill: '#fff' }], ['circle', { cx: 120, cy: 330, r: 3, fill: '#fff' }], ['path', { d: 'M0 360 Q150 330 300 360 T600 350 V400 H0Z', fill: '#e8f1fa' }]] },
    'candy-stripe': { label: 'Candy stripe', bg: '#fff6f2', ink: '#7a1020', edge: '#c8243c', shapes: [['path', { d: 'M0 0H600V24H0ZM0 376H600V400H0Z', fill: '#c8243c' }], ['path', { d: 'M0 24H600V32H0ZM0 368H600V376H0Z', fill: '#fff' }]] },
    holly: { label: 'Holly', bg: '#f7f3e8', ink: '#1f4d2c', edge: '#2f6b3f', shapes: [['path', { d: 'M30 40c20-10 40 0 50 20-20 0-40 10-50-20ZM80 30c10 20 0 40-20 50 0-20-10-40 20-50Z', fill: '#2f6b3f' }], ['circle', { cx: 70, cy: 60, r: 7, fill: '#c8243c' }], ['path', { d: 'M570 360c-20 10-40 0-50-20 20 0 40-10 50 20ZM520 370c-10-20 0-40 20-50 0 20 10 40-20 50Z', fill: '#2f6b3f' }], ['circle', { cx: 530, cy: 340, r: 7, fill: '#c8243c' }]] },
    gingerbread: { label: 'Gingerbread', bg: '#a4643a', ink: '#fff8ee', edge: '#fff8ee', shapes: [['path', { d: 'M20 20H580V380H20Z', fill: 'none', stroke: '#fff8ee', 'stroke-width': 6, 'stroke-dasharray': '2 14', 'stroke-linecap': 'round' }]] },
    starry: { label: 'Starry', bg: '#2b2140', ink: '#ffe9a8', edge: '#f2c14e', shapes: [['path', { d: 'M90 60l6 14 15 1-12 9 4 15-13-8-13 8 4-15-12-9 15-1Z', fill: '#f2c14e' }], ['path', { d: 'M510 300l5 11 12 1-9 7 3 12-11-6-10 6 3-12-9-7 12-1Z', fill: '#f2c14e' }], ['circle', { cx: 480, cy: 70, r: 3, fill: '#ffe9a8' }], ['circle', { cx: 140, cy: 320, r: 3, fill: '#ffe9a8' }]] },
  }
  const DESIGN_NAMES = Object.entries(DESIGNS).map(([value, design]) => [value, design.label])
  const STICKERS = {
    star: [['path', { d: 'M0-12 3.5-4 12-3.5 5.5 2 7.5 11 0 6.5-7.5 11-5.5 2-12-3.5-3.5-4Z', fill: '#f2c14e' }]],
    heart: [['path', { d: 'M0 10C-11 3-12-4-8-8-4-11 0-7 0-5 0-7 4-11 8-8 12-4 11 3 0 10Z', fill: '#d6455a' }]],
    snowflake: [['path', { d: 'M0-11V11M-9.5-5.5 9.5 5.5M-9.5 5.5 9.5-5.5', stroke: '#7fb3e0', 'stroke-width': 2.4, 'stroke-linecap': 'round' }]],
    'candy-cane': [['path', { d: 'M3 12V-4a6 6 0 0 0-12 0', stroke: '#fff', 'stroke-width': 5, fill: 'none', 'stroke-linecap': 'round' }], ['path', { d: 'M3 12V-4a6 6 0 0 0-12 0', stroke: '#c8243c', 'stroke-width': 5, fill: 'none', 'stroke-dasharray': '3 3', 'stroke-linecap': 'round' }]],
    bell: [['path', { d: 'M0-10C-7-10-7-2-7 2L-9 7H9L7 2C7-2 7-10 0-10Z', fill: '#e0a12e' }], ['circle', { cy: 9, r: 2.4, fill: '#b8862a' }]],
    mitten: [['path', { d: 'M-6 8V-4C-6-10 6-10 6-4V2L9-1C11-3 13-1 11 1L6 8Z', fill: '#c8364a' }], ['rect', { x: -7, y: 7, width: 14, height: 5, rx: 1.5, fill: '#fff' }]],
    cookie: [['circle', { r: 10, fill: '#c98a4b' }], ['circle', { cx: -3, cy: -3, r: 1.6, fill: '#5a3518' }], ['circle', { cx: 4, cy: 2, r: 1.6, fill: '#5a3518' }]],
    ornament: [['rect', { x: -3, y: -13, width: 6, height: 4, rx: 1, fill: '#c9a24a' }], ['circle', { r: 10, fill: '#2f6fd0' }], ['circle', { cx: -4, cy: -4, r: 3, fill: '#fff', opacity: 0.5 }]],
    holly: [['path', { d: 'M-12-2c6-6 12-4 12 2-6 2-10 2-12-2ZM12-2c-6-6-12-4-12 2 6 2 10 2 12-2Z', fill: '#2f6b3f' }], ['circle', { cy: 3, r: 3.5, fill: '#c8243c' }]],
    gift: [['rect', { x: -9, y: -4, width: 18, height: 13, fill: '#2f6b3f' }], ['rect', { x: -10, y: -8, width: 20, height: 5, fill: '#3f8a52' }], ['rect', { x: -1.5, y: -8, width: 3, height: 17, fill: '#f2c14e' }]],
  }
  const el = (name, attributes = {}) => {
    const node = document.createElementNS(NS, name)
    for (const [key, value] of Object.entries(attributes)) node.setAttribute(key, String(value))
    return node
  }
  const wrapLines = (words, width = 38, max = 9) => {
    const lines = []
    for (const paragraph of String(words || '').split('\n')) {
      let line = ''
      for (const word of paragraph.split(/\s+/).filter(Boolean)) {
        const next = line ? `${line} ${word}` : word
        if (next.length > width && line) { lines.push(line); line = word.slice(0, width) } else line = next.slice(0, width + 10)
      }
      lines.push(line)
    }
    return lines.length > max ? [...lines.slice(0, max - 1), `${lines[max - 1]}…`] : lines
  }
  const safePhoto = (src) => /^data:image\/(png|jpeg);base64,[A-Za-z0-9+/]+={0,2}$/.test(src || '')
  const lum = (hex) => {
    const part = (i) => parseInt(hex.slice(1 + i * 2, 3 + i * 2), 16) / 255
    const lin = (c) => (c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4)
    const [r, g, b] = [0, 1, 2].map((i) => lin(part(i)))
    return 0.2126 * r + 0.7152 * g + 0.0722 * b
  }
  const readable = (hex) => (lum(hex) > 0.4 ? '#1f2633' : '#fffdf8')
  const contrast = (a, b) => {
    const [hi, lo] = lum(a) > lum(b) ? [lum(a), lum(b)] : [lum(b), lum(a)]
    return (hi + 0.05) / (lo + 0.05)
  }
  const inkOn = (ground, color) => (contrast(color, ground) < 3 ? readable(ground) : color)
  const drawStroke = (svg, stroke) => {
    const points = stroke.points || []
    if (!points.length) return
    if (points.length < 2) {
      const [x, y] = points[0]
      svg.append(el('circle', { cx: x, cy: y, r: Math.max(1, stroke.size / 2), fill: stroke.color }))
      return
    }
    svg.append(el('polyline', {
      points: points.map((point) => point.join(',')).join(' '),
      fill: 'none', stroke: stroke.color, 'stroke-width': stroke.size, 'stroke-linecap': 'round', 'stroke-linejoin': 'round',
    }))
  }
  // A card an older gift already has (no paper color, no drawing, no placed words) is drawn the
  // same way as before: the design, the centered words, the sign-off, and stickers at scale 1.8.
  const drawCard = (card, extra = {}) => {
    const design = DESIGNS[card.design] || DESIGNS.holly
    const ink = card.bg ? readable(card.bg) : design.ink
    const svg = el('svg', { viewBox: `0 0 ${W} ${H}`, role: 'img' })
    const title = el('title')
    title.textContent = 'How your card looks'
    svg.append(title, el('rect', { width: W, height: H, rx: 18, fill: card.bg || design.bg, stroke: design.edge, 'stroke-width': 6 }))
    if (!card.plain) for (const [name, attributes] of design.shapes) svg.append(el(name, attributes))
    for (const picture of card.pictures || []) {
      if (!safePhoto(picture.src)) continue
      const cx = (picture.x / 100) * W
      const cy = (picture.y / 100) * H
      const image = el('image', { href: picture.src, x: cx - picture.w / 2, y: cy - picture.h / 2, width: picture.w, height: picture.h })
      if (picture.turn) image.setAttribute('transform', `rotate(${picture.turn} ${cx} ${cy})`)
      svg.append(image)
    }
    for (const stroke of card.marks || []) drawStroke(svg, stroke)
    if (extra.draft?.kind === 'draw') drawStroke(svg, { color: pen, size: penSize, points: extra.draft.points })
    let lines = wrapLines(card.message)
    const small = lines.length > 6 || lines.some((line) => line.endsWith('…'))
    if (small) lines = wrapLines(card.message, 50, 12)
    const step = small ? 23 : 32
    const text = el('text', { x: W / 2, y: H / 2 - ((lines.length - 1) * step) / 2, 'text-anchor': 'middle', 'dominant-baseline': 'middle', fill: ink, 'font-size': small ? 19 : 26, 'font-family': 'Georgia, serif' })
    lines.forEach((line, index) => {
      const span = el('tspan', { x: W / 2, dy: index === 0 ? 0 : step })
      span.textContent = line
      text.append(span)
    })
    svg.append(text)
    if (card.signOff) {
      const sign = el('text', { x: W - 60, y: H - 50, 'text-anchor': 'end', fill: ink, 'font-size': 24, 'font-style': 'italic', 'font-family': 'Georgia, serif' })
      sign.textContent = `— ${card.signOff}`
      svg.append(sign)
    }
    for (const item of card.texts || []) {
      const x = (item.x / 100) * W
      const y = (item.y / 100) * H
      const node = el('text', { x, y, 'text-anchor': 'middle', 'dominant-baseline': 'middle', fill: item.color, 'font-size': item.size, 'font-family': 'Georgia, serif' })
      if (item.turn) node.setAttribute('transform', `rotate(${item.turn} ${x} ${y})`)
      node.textContent = item.text
      svg.append(node)
    }
    for (const sticker of card.stickers || []) {
      const tx = 30 + (sticker.x / 100) * (W - 60)
      const ty = 30 + (sticker.y / 100) * (H - 60)
      const scale = sticker.size && sticker.size !== 100 ? 1.8 * sticker.size / 100 : 1.8
      const transform = sticker.turn ? `translate(${tx} ${ty}) rotate(${sticker.turn}) scale(${scale})` : `translate(${tx} ${ty}) scale(${scale})`
      const group = el('g', { transform })
      for (const [name, attributes] of STICKERS[sticker.kind] || []) group.append(el(name, attributes))
      svg.append(group)
    }
    const which = extra.picked
    if (which?.kind === 'sticker' && card.stickers?.[which.index]) {
      const sticker = card.stickers[which.index]
      const x = 30 + (sticker.x / 100) * (W - 60)
      const y = 30 + (sticker.y / 100) * (H - 60)
      const reach = 56 * ((sticker.size || 100) / 100)
      svg.append(el('rect', { x: x - reach / 2, y: y - reach / 2, width: reach, height: reach, rx: 6, fill: 'none', stroke: '#1f2633', 'stroke-width': 2, 'stroke-dasharray': '5 4' }))
    } else if (which?.kind === 'text' && card.texts?.[which.index]) {
      const item = card.texts[which.index]
      const x = (item.x / 100) * W
      const y = (item.y / 100) * H
      const rw = Math.max(48, String(item.text).length * item.size * 0.56)
      const rh = item.size + 16
      svg.append(el('rect', { x: x - rw / 2, y: y - rh / 2, width: rw, height: rh, rx: 6, fill: 'none', stroke: '#1f2633', 'stroke-width': 2, 'stroke-dasharray': '5 4' }))
    } else if (which?.kind === 'picture' && card.pictures?.[which.index]) {
      const item = card.pictures[which.index]
      const x = (item.x / 100) * W
      const y = (item.y / 100) * H
      svg.append(el('rect', { x: x - item.w / 2 - 4, y: y - item.h / 2 - 4, width: item.w + 8, height: item.h + 8, rx: 6, fill: 'none', stroke: '#1f2633', 'stroke-width': 2, 'stroke-dasharray': '5 4' }))
    }
    return svg
  }
  // The pointer work on the card. Kept off the template's state until a gesture finishes, so a
  // line being drawn doesn't rebuild the form on every move.
  const gesture = { current: null }
  const remember = () => {
    past = [...past.slice(-29), {
      stuck: stuck.map((item) => ({ ...item })),
      marks: marks.map((stroke) => ({ ...stroke, points: stroke.points.map((point) => [...point]) })),
      texts: texts.map((item) => ({ ...item })),
      pictures: pictures.map((item) => ({ ...item })),
      paperColor,
      plain,
    }]
  }
  const cardPoint = (e) => {
    const svg = e.currentTarget.querySelector('svg')
    if (!svg) return null
    const box = svg.getBoundingClientRect()
    if (!box.width || !box.height) return null
    return {
      x: clamp(((e.clientX - box.left) / box.width) * W, 0, W),
      y: clamp(((e.clientY - box.top) / box.height) * H, 0, H),
    }
  }
  const hit = (p) => {
    for (let i = stuck.length - 1; i >= 0; i -= 1) {
      const sticker = stuck[i]
      const x = 30 + (sticker.x / 100) * (W - 60)
      const y = 30 + (sticker.y / 100) * (H - 60)
      if (Math.hypot(p.x - x, p.y - y) <= 26 * ((sticker.size || 100) / 100)) return { kind: 'sticker', index: i }
    }
    for (let i = texts.length - 1; i >= 0; i -= 1) {
      const item = texts[i]
      const x = (item.x / 100) * W
      const y = (item.y / 100) * H
      const half = Math.max(22, String(item.text).length * item.size * 0.28)
      if (Math.abs(p.x - x) <= half && Math.abs(p.y - y) <= item.size * 0.7) return { kind: 'text', index: i }
    }
    for (let i = pictures.length - 1; i >= 0; i -= 1) {
      const item = pictures[i]
      const x = (item.x / 100) * W
      const y = (item.y / 100) * H
      if (Math.abs(p.x - x) <= item.w / 2 && Math.abs(p.y - y) <= item.h / 2) return { kind: 'picture', index: i }
    }
    return null
  }
  const listOf = (kind) => (kind === 'sticker' ? stuck : kind === 'text' ? texts : pictures)
  const setList = (kind, list) => {
    if (kind === 'sticker') stuck = list
    else if (kind === 'text') texts = list
    else pictures = list
  }
  const eraseAt = (p) => {
    const left = marks.filter((stroke) => !stroke.points.some(([x, y]) => Math.hypot(p.x - x, p.y - y) <= stroke.size + 10))
    if (left.length !== marks.length) marks = left
  }
  const shift = (kind, index, dx, dy) => {
    const list = listOf(kind).slice()
    const item = { ...list[index] }
    const across = kind === 'sticker' ? W - 60 : W
    const down = kind === 'sticker' ? H - 60 : H
    item.x = clamp(item.x + (dx / across) * 100, 0, 100)
    item.y = clamp(item.y + (dy / down) * 100, 0, 100)
    list[index] = item
    setList(kind, list)
  }

  // The floor under the tree. A place is x (0 to 100, across) and y (0 at the back, 100 at the front).
  // The floor is twice as wide as it is tall and boxes stand on its lower three fifths, so one step
  // toward the front covers three tenths of the ground a step across does.
  const DEPTH = 0.3
  const clamp = (n, low, high) => Math.min(high, Math.max(low, n))
  const hash = (words) => {
    let h = 2166136261
    for (const c of String(words)) h = Math.imul(h ^ c.charCodeAt(0), 16777619)
    return h >>> 0
  }
  // Every box settled in turn: it starts where its giver put it and is pushed off any box already
  // down until their middles are at least three fifths of a box apart. The more gifts, the smaller.
  const settle = (list) => {
    const n = list.length
    const w = n > 60 ? 7 : n > 30 ? 9 : n > 12 ? 11 : 14
    const apart = w * 0.6
    const down = []
    for (const gift of list) {
      const h = hash(gift.id)
      let x = gift.spot ? gift.spot.x : 6 + (h % 89)
      let y = gift.spot ? gift.spot.y : (h >>> 8) % 101
      for (let turn = 0; turn < 24; turn += 1) {
        let moved = false
        for (const other of down) {
          const dx = x - other.x
          const dy = (y - other.y) * DEPTH
          const far = Math.hypot(dx, dy)
          if (far < apart - 0.01) {
            const way = far < 0.01 ? (h % 628) / 100 : Math.atan2(dy, dx)
            x = other.x + Math.cos(way) * apart
            y = other.y + (Math.sin(way) * apart) / DEPTH
            moved = true
          }
        }
        x = clamp(x, w / 2, 100 - w / 2)
        y = clamp(y, 0, 100)
        if (!moved) break
      }
      down.push({ id: gift.id, wrap: gift.wrap, bow: gift.bow || 'gold', mine: gift.mine === true, from: gift.from || '', x, y, w })
    }
    return down
  }
  // Where a settled box is drawn: its foot on the floor, smaller toward the back, nearer ones in front.
  const left = (box) => `${box.x.toFixed(2)}%`
  const foot = (box) => `${(40 + box.y * 0.6).toFixed(2)}%`
  const wide = (box) => `${(box.w * (0.8 + box.y / 500)).toFixed(2)}%`
  const near = (box) => String(Math.round(box.y) + 1)

  // A server function is called the way Zubra's own form script calls one: a post of the form's fields,
  // asking for JSON. What it returns comes back as it is.
  const call = async (fn, data = new FormData()) => {
    const reply = await fetch(fn, { method: 'POST', headers: { accept: 'application/json' }, body: data })
    if (!reply.ok) throw new Error(String(reply.status))
    return reply.json()
  }

  let state = 'hidden'
  let gifts = []
  let open = false
  let kind = 'note'
  let asks = true
  let busy = false
  let said = ''
  let problem = ''
  let stuck = []
  let token = ''
  let spot = { x: 50, y: 70 }
  let paper = 'red'
  let ribbon = 'gold'
  let tucked = false
  let tool = 'move'
  let pen = '#1f2633'
  let penSize = 6
  let paperColor = ''
  let plain = false
  let marks = []
  let texts = []
  let pictures = []
  let picked = null
  let past = []

  const count = () => (gifts.length === 0 ? 'Nothing under the tree yet. Yours could be the first.' : gifts.length === 1 ? 'One gift is under the tree.' : `${gifts.length} gifts are under the tree.`)
  const pile = () => settle(gifts)
  const withMine = () => settle([...gifts, { id: 'yours', wrap: paper, bow: ribbon, mine: true, spot }])
  // Who the named ones are from, said once under the pile: boxes this small can't carry a name.
  const fromWhom = () => {
    const names = [...new Set(gifts.map((gift) => gift.from).filter(Boolean))]
    if (!names.length) return ''
    const shown = names.slice(0, 12)
    const more = gifts.length - gifts.filter((gift) => shown.includes(gift.from)).length
    const list = shown.length > 1 && !more ? `${shown.slice(0, -1).join(', ')} and ${shown.at(-1)}` : shown.join(', ')
    return `From ${list}${more ? `, and ${more} more` : ''}.`
  }

  // Setting hers down: a tap or a drag on the floor in the form, or the four buttons.
  const put = (x, y) => { spot = { x: Math.round(clamp(x, 0, 100)), y: Math.round(clamp(y, 0, 100)) } }
  const point = (e) => {
    if (e.type === 'pointermove' && !e.buttons) return
    const box = e.currentTarget.getBoundingClientRect()
    put(((e.clientX - box.left) / box.width) * 100, (((e.clientY - box.top) / box.height) * 100 - 40) / 0.6)
  }
  const nudge = (dx, dy) => put(spot.x + dx, spot.y + dy)

  const cardFrom = (form) => {
    const data = new FormData(form)
    return {
      design: String(data.get('design') || 'holly'),
      message: String(data.get('message') || '').trim(),
      signOff: String(data.get('signOff') || '').trim(),
      stickers: stuck,
      bg: paperColor,
      plain,
      marks,
      texts,
      pictures,
    }
  }
  const redraw = (form, draft) => {
    const preview = form && form.querySelector('.preview')
    if (preview) preview.replaceChildren(drawCard(cardFrom(form), { draft, picked }))
  }
  const pickedHelp = () => (picked ? 'Selected. Drag it on the card, or use the buttons under it.' : 'Select something on the card, or add a sticker, words or a photo.')
  const stickerPayload = () => stuck.map((sticker) => {
    const out = { kind: sticker.kind, x: Math.round(clamp(sticker.x, 0, 100)), y: Math.round(clamp(sticker.y, 0, 100)) }
    if (sticker.turn) out.turn = Math.round(sticker.turn)
    if (sticker.size && sticker.size !== 100) out.size = Math.round(sticker.size)
    return out
  })
  const scenePayload = () => {
    const scene = {}
    if (paperColor) scene.bg = paperColor
    if (plain) scene.plain = true
    if (marks.length) scene.marks = marks.map((stroke) => ({ color: stroke.color, size: stroke.size, points: stroke.points.map((point) => [Math.round(point[0]), Math.round(point[1])]) }))
    if (texts.length) scene.texts = texts.map((item) => {
      const out = { text: item.text, x: Math.round(item.x), y: Math.round(item.y), size: item.size, color: item.color }
      if (item.turn) out.turn = Math.round(item.turn)
      return out
    })
    if (pictures.length) scene.pictures = pictures.map((item) => {
      const out = { src: item.src, x: Math.round(item.x), y: Math.round(item.y), w: Math.round(item.w), h: Math.round(item.h) }
      if (item.turn) out.turn = Math.round(item.turn)
      return out
    })
    return scene
  }
  const resetCard = () => {
    stuck = []
    marks = []
    texts = []
    pictures = []
    paperColor = ''
    plain = false
    picked = null
    past = []
    tool = 'move'
    pen = '#1f2633'
    penSize = 6
    gesture.current = null
  }

  const start = async (e) => {
    open = true
    said = ''
    problem = ''
    const root = e.currentTarget.closest('gift-maker')
    // The form has to have been open a few seconds before a gift is taken: it keeps robots out.
    try { token = (await call(look)).token || '' } catch (_) { token = '' }
    const form = root && root.querySelector('form')
    if (form) { redraw(form); const first = form.querySelector('input[name="from"]'); if (first) first.focus(); requestAnimationFrame(tuck) }
  }
  const choose = (e) => {
    if (e.target.name === 'kind') kind = e.target.value
    if (e.target.name === 'wrap') paper = e.target.value
    if (e.target.name === 'bow') ribbon = e.target.value
    if (problem) problem = ''
    redraw(e.currentTarget)
  }
  const stick = (e, name) => {
    if (stuck.length >= SPOTS.length) return
    remember()
    const [x, y] = SPOTS[stuck.length]
    stuck = [...stuck, { kind: name, x, y }]
    picked = { kind: 'sticker', index: stuck.length - 1 }
    tool = 'move'
    redraw(e.currentTarget.form)
  }
  const unstick = (e) => {
    if (!stuck.length) return
    remember()
    stuck = []
    if (picked && picked.kind === 'sticker') picked = null
    redraw(e.currentTarget.form)
  }
  const useTool = (e, name) => {
    tool = name
    if (name !== 'move') picked = null
    redraw(e.currentTarget.form)
  }
  const choosePen = (e, color) => { pen = color; tool = 'draw'; redraw(e.currentTarget.form) }
  const customPen = (e) => { pen = String(e.target.value || '').toLowerCase(); tool = 'draw'; redraw(e.target.form) }
  const groundOf = (form) => {
    const name = String(new FormData(form).get('design') || 'holly')
    return paperColor || (DESIGNS[name] || DESIGNS.holly).bg
  }
  const setPaper = (form, color) => {
    paperColor = color
    const ground = groundOf(form)
    pen = inkOn(ground, pen)
    texts = texts.map((item) => ({ ...item, color: inkOn(ground, item.color) }))
    redraw(form)
  }
  const choosePaper = (e, color) => setPaper(e.currentTarget.form, color)
  const customPaper = (e) => setPaper(e.target.form, String(e.target.value || '').toLowerCase())
  const chooseSize = (size) => { penSize = size; tool = 'draw' }
  const togglePlain = (e) => { plain = e.target.checked; redraw(e.target.form) }
  const undo = (e) => {
    const prev = past.at(-1)
    if (!prev) return
    past = past.slice(0, -1)
    stuck = prev.stuck
    marks = prev.marks
    texts = prev.texts
    pictures = prev.pictures
    paperColor = prev.paperColor
    plain = prev.plain
    picked = null
    gesture.current = null
    redraw(e.currentTarget.form)
  }
  const clearArt = (e) => {
    remember()
    stuck = []
    marks = []
    texts = []
    pictures = []
    plain = false
    paperColor = ''
    picked = null
    gesture.current = null
    redraw(e.currentTarget.form)
  }
  const placeText = (form, x, y) => {
    const input = form.querySelector('#gift-place')
    const words = String(input ? input.value : '').replace(/\s+/g, ' ').trim()
    if (!words) { problem = 'Write the words in the box, then tap the card where they should go.'; return }
    if (words.length > 80 || texts.length >= 12) { problem = WHY['bad-text']; return }
    remember()
    texts = [...texts, { text: words, x: Math.round(clamp(x, 0, 100)), y: Math.round(clamp(y, 0, 100)), size: 32, color: inkOn(groundOf(form), pen) }]
    picked = { kind: 'text', index: texts.length - 1 }
    tool = 'move'
    if (input) input.value = ''
    problem = ''
    redraw(form)
  }
  const changePicked = (e, change) => {
    if (!picked) return
    const list = listOf(picked.kind)
    const current = list[picked.index]
    if (!current) return
    remember()
    const next = list.slice()
    next[picked.index] = change({ ...current })
    setList(picked.kind, next)
    redraw(e.currentTarget.form)
  }
  const turnPicked = (e, by) => changePicked(e, (item) => {
    const turn = Math.max(-180, Math.min(180, (item.turn || 0) + by))
    if (turn) item.turn = turn
    else delete item.turn
    return item
  })
  const sizePicked = (e, by) => changePicked(e, (item) => {
    if (picked.kind === 'text') {
      const at = Math.max(0, TEXT_SIZES.indexOf(item.size))
      item.size = TEXT_SIZES[Math.max(0, Math.min(TEXT_SIZES.length - 1, at + by))]
      return item
    }
    if (picked.kind === 'picture') {
      const factor = by > 0 ? 1.15 : 0.87
      item.w = Math.max(8, Math.min(520, Math.round(item.w * factor)))
      item.h = Math.max(8, Math.min(360, Math.round(item.h * factor)))
      return item
    }
    const sizes = [40, 70, 100, 140, 180, 220]
    const at = sizes.reduce((best, size, index) => (Math.abs(size - (item.size || 100)) < Math.abs(sizes[best] - (item.size || 100)) ? index : best), 0)
    const next = sizes[Math.max(0, Math.min(sizes.length - 1, at + by))]
    if (next === 100) delete item.size
    else item.size = next
    return item
  })
  const nudgePicked = (e, dx, dy) => changePicked(e, (item) => {
    item.x = clamp(item.x + dx, 0, 100)
    item.y = clamp(item.y + dy, 0, 100)
    return item
  })
  const frontPicked = (e) => {
    if (!picked) return
    const list = listOf(picked.kind)
    if (picked.index >= list.length - 1) return
    remember()
    const next = list.slice()
    const [item] = next.splice(picked.index, 1)
    next.push(item)
    setList(picked.kind, next)
    picked = { kind: picked.kind, index: next.length - 1 }
    redraw(e.currentTarget.form)
  }
  const removePicked = (e) => {
    if (!picked) return
    remember()
    const next = listOf(picked.kind).slice()
    next.splice(picked.index, 1)
    setList(picked.kind, next)
    picked = null
    redraw(e.currentTarget.form)
  }
  const onCardPointer = (e) => {
    const form = e.currentTarget.closest('form')
    const p = cardPoint(e)
    if (!p || !form) return
    if (e.type === 'pointerdown') {
      if (e.cancelable) e.preventDefault()
      try { e.currentTarget.setPointerCapture(e.pointerId) } catch (_) {}
      if (tool === 'draw') {
        if (marks.length >= 40) { problem = WHY['bad-drawing']; return }
        remember()
        gesture.current = { kind: 'draw', points: [[Math.round(p.x), Math.round(p.y)]] }
        return
      }
      if (tool === 'erase') {
        remember()
        gesture.current = { kind: 'erase' }
        eraseAt(p)
        redraw(form)
        return
      }
      if (tool === 'text') { placeText(form, (p.x / W) * 100, (p.y / H) * 100); return }
      const found = hit(p)
      picked = found
      if (found) {
        remember()
        gesture.current = { kind: 'drag', itemKind: found.kind, index: found.index, x: p.x, y: p.y }
      } else gesture.current = null
      redraw(form)
      return
    }
    const current = gesture.current
    if (!current) return
    if (e.type === 'pointermove') {
      if (current.kind === 'draw') {
        const last = current.points.at(-1)
        if (Math.hypot(p.x - last[0], p.y - last[1]) < 4 || current.points.length >= 80) return
        current.points.push([Math.round(p.x), Math.round(p.y)])
        redraw(form, current)
        return
      }
      if (current.kind === 'erase') { eraseAt(p); redraw(form); return }
      if (current.kind === 'drag') {
        shift(current.itemKind, current.index, p.x - current.x, p.y - current.y)
        current.x = p.x
        current.y = p.y
        redraw(form)
      }
      return
    }
    if (e.type === 'pointerup' || e.type === 'pointercancel') {
      if (current.kind === 'draw' && current.points.length) marks = [...marks, { color: pen, size: penSize, points: current.points }]
      gesture.current = null
      redraw(form)
    }
  }
  const loadImage = (url) => new Promise((resolve, reject) => {
    const img = new Image()
    img.onload = () => resolve(img)
    img.onerror = () => reject(new Error('image'))
    img.src = url
  })
  const shrinkPhoto = (img) => {
    let w = img.naturalWidth
    let h = img.naturalHeight
    if (!w || !h) return null
    const scale = Math.min(1, 280 / Math.max(w, h))
    w = Math.max(8, Math.round(w * scale))
    h = Math.max(8, Math.round(h * scale))
    const canvas = document.createElement('canvas')
    canvas.width = w
    canvas.height = h
    const ctx = canvas.getContext('2d')
    if (!ctx) return null
    ctx.fillStyle = '#ffffff'
    ctx.fillRect(0, 0, w, h)
    ctx.drawImage(img, 0, 0, w, h)
    let quality = 0.72
    let src = canvas.toDataURL('image/jpeg', quality)
    while (src.length > 70000 && quality > 0.4) {
      quality = Math.round((quality - 0.1) * 10) / 10
      src = canvas.toDataURL('image/jpeg', quality)
    }
    if (!safePhoto(src) || src.length > 70000) return null
    return { src, w: Math.min(520, w), h: Math.min(360, h) }
  }
  const addPhoto = async (e) => {
    const input = e.currentTarget
    const file = input.files && input.files[0]
    input.value = ''
    const form = input.form
    if (!file) return
    if (pictures.length >= 2) { problem = WHY['too-many-pictures']; return }
    if (!/^image\/(png|jpeg)$/.test(file.type)) { problem = WHY['bad-picture']; return }
    const url = URL.createObjectURL(file)
    try {
      const made = shrinkPhoto(await loadImage(url))
      if (!made || pictures.length >= 2) { problem = pictures.length >= 2 ? WHY['too-many-pictures'] : WHY['bad-picture']; return }
      remember()
      pictures = [...pictures, { ...made, x: 50, y: 46 }]
      picked = { kind: 'picture', index: pictures.length - 1 }
      tool = 'move'
      problem = ''
      redraw(form)
    } catch (_) {
      problem = WHY['bad-picture']
    } finally {
      URL.revokeObjectURL(url)
    }
  }

  const WHY = {
    'family-code': 'That isn’t the family password. Ask Grammi for it.',
    'slow-down': 'That’s a lot of gifts in one hour. Try again a little later.',
    'tree-full': 'The tree is full for this year. Thank you for thinking of her.',
    'not-ready': 'Grammi is still decorating. Come back soon.',
    token: 'That took a while. Press the button once more.',
    'from-length': 'Add your name, 40 letters at most.',
    'note-length': 'Write your note, 1,000 letters at most.',
    'message-length': 'Write a few words for the card, or draw, place words, or add a sticker.',
    'sign-off-length': 'The sign-off can be 40 letters at most.',
    'bad-sticker': 'That sticker didn’t stick. Take it off and try again.',
    'too-many-stickers': 'Eight stickers is the most.',
    'bad-drawing': 'The card is full of drawing. Erase a line to add more.',
    'bad-text': 'Keep each bit of writing short, and on the card.',
    'bad-picture': 'Use a photo that’s a JPG or PNG, and not too big.',
    'too-many-pictures': 'Two photos is the most a card can hold.',
    'bad-color': 'Pick a color for the card.',
    'card-too-big': 'That card is too full. Take a photo or a drawing off.',
  }

  const send = async (e) => {
    e.preventDefault()
    if (busy) return
    const form = e.currentTarget
    const data = new FormData(form)
    const from = String(data.get('from') || '').trim()
    const note = String(data.get('note') || '').trim()
    const card = cardFrom(form)
    const made = card.message || card.signOff || card.stickers.length || card.marks.length || card.texts.length || card.pictures.length
    problem = !from ? WHY['from-length'] : kind === 'note' && !note ? WHY['note-length'] : kind === 'card' && !made ? WHY['message-length'] : ''
    if (problem) return
    busy = true
    try {
      // The form's own fields, and what it holds outside them: the token, where the box was set down,
      // the stickers, and anything drawn or placed on the card.
      data.set('kind', kind)
      data.set('token', token)
      data.set('spotX', String(spot.x))
      data.set('spotY', String(spot.y))
      data.set('stickers', JSON.stringify(stickerPayload()))
      data.set('scene', JSON.stringify(scenePayload()))
      const answer = await call(leave, data)
      if (answer.error) {
        problem = WHY[answer.error] || 'That didn’t go under the tree. Try again in a minute.'
        if (answer.error === 'token') { try { token = (await call(look)).token || '' } catch (_) {} }
      } else {
        if (answer.gift) gifts = [...gifts, { ...answer.gift, bow: answer.gift.bow || ribbon, spot: answer.gift.spot || spot }]
        spot = { x: 50, y: 70 }
        paper = 'red'
        ribbon = 'gold'
        said = 'Your gift is under the tree. Grammi opens it on Christmas morning.'
        open = false
        resetCard()
        form.reset()
        kind = 'note'
        requestAnimationFrame(tuck)
      }
    } catch (_) {
      problem = 'That didn’t go under the tree. Check your connection and try again.'
    }
    busy = false
  }

  // When the Christmas tree is the section right above, the pile is drawn at its foot: the floor is
  // pulled up over the gap so the boxes sit around the trunk. Measured again when the page resizes.
  const tuck = () => {
    const root = document.querySelector('gift-maker')
    const tree = document.querySelector('grammis-tree:not([data-gift-preview]) .tree')
    if (!root || !tree) { tucked = false; return }
    const above = tree.getBoundingClientRect()
    const here = root.getBoundingClientRect()
    const gap = here.top - above.bottom
    if (!above.height || gap < -4 || gap > 160) { tucked = false; return }
    const under = root.querySelector('.under')
    const style = getComputedStyle(under)
    const floorWidth = under.clientWidth - parseFloat(style.paddingLeft) - parseFloat(style.paddingRight)
    if (!floorWidth) { tucked = false; return }
    root.style.setProperty('--tuck', `${Math.round(gap)}px`)
    root.style.setProperty('--preview-tree-width', `${(above.width / floorWidth) * 100}%`)
    root.style.setProperty('--preview-overlap', `${(Math.min(innerWidth * 0.34, 11.5 * parseFloat(getComputedStyle(document.documentElement).fontSize)) / floorWidth) * 100}%`)
    tucked = true
    const preview = root.querySelector('.placement-tree')
    if (preview && !preview.firstElementChild) {
      const original = tree.closest('grammis-tree')
      const copy = document.createElement('grammis-tree')
      for (const name of ['topper', 'nolights', 'hung', 'zb-props']) {
        if (original.hasAttribute(name)) copy.setAttribute(name, original.getAttribute(name))
      }
      copy.setAttribute('data-gift-preview', '')
      copy.setAttribute('aria-hidden', 'true')
      copy.setAttribute('shows', 'always')
      if ('topper' in original) {
        copy.topper = original.topper
        copy.nolights = original.nolights
        copy.hung = original.hung
      }
      preview.append(copy)
    }
  }

  onMount(async () => {
    const now = new Date()
    const month = now.getMonth()
    const date = now.getDate()
    const inSeason = (month === 10 && date >= 20) || month === 11 || (month === 0 && date <= 6)
    if (shows !== 'always' && !inSeason) return
    try {
      const tree = await call(look)
      // Grammi says when her tree is ready for gifts; until then this stays off the page.
      if (tree.ready === false) return
      gifts = Array.isArray(tree.gifts) ? tree.gifts.slice(0, 200) : []
      asks = tree.anyone !== true
      state = 'shown'
      requestAnimationFrame(tuck)
      addEventListener('resize', tuck)
    } catch (_) {}
  })
</script>
<style>
  :host { display: block; }
  .under { display: none; max-width: 34rem; margin: 1.5rem auto; padding: 0 0.5rem; color: var(--foreground, #1f2633); }
  .under:has(form:not([hidden])) { max-width: 42rem; }
  .under[data-state="shown"] { display: block; }
  .heading { margin: 0 0 0.3rem; text-align: center; font-family: var(--ob-font-heading, Georgia, serif); font-size: 1.5rem; }
  .count, .said, .problem, .help { margin: 0.3rem 0; text-align: center; }
  .help { text-align: left; font-size: 0.95rem; color: var(--muted-foreground, #5a6170); }
  .said { font-weight: 600; }
  .problem { color: #a11224; font-weight: 600; }
  .floor { position: relative; list-style: none; margin: 0.6rem 0 0.2rem; padding: 0; aspect-ratio: 2 / 1; overflow: hidden; border-radius: 10px;
    background: radial-gradient(120% 70% at 50% 100%, color-mix(in srgb, var(--primary, #a11224) 16%, transparent), transparent 70%); }
  .floor[data-placing="true"] { touch-action: none; cursor: crosshair; outline: 2px dashed var(--border, #8d897c); outline-offset: -2px; }
  .placement-tree { pointer-events: none; }
  .placement-tree grammis-tree .stand { width: var(--preview-tree-width); max-width: none; margin: 0 auto; }
  .placement-tree:not([hidden]) + .floor { z-index: 2; margin-top: calc(-1 * var(--preview-overlap) - 0.5rem); }
  .box { position: absolute; left: var(--x); top: var(--y); width: var(--w); z-index: var(--z); aspect-ratio: 1 / 0.88; translate: -50% -100%; border-radius: 3px; box-shadow: 0 3px 4px -2px rgb(0 0 0 / 0.55); pointer-events: none;
    background: linear-gradient(90deg, transparent 42%, var(--bow, #f2c14e) 42% 58%, transparent 58%), linear-gradient(transparent 38%, var(--bow, #f2c14e) 38% 52%, transparent 52%), var(--paper, #c8243c); }
  /* The bow: two loops and a knot on the lid, in the ribbon's colour. "No bow" is a box left plain. */
  .box::after { content: ""; position: absolute; left: 50%; bottom: 92%; width: 70%; aspect-ratio: 2 / 1; translate: -50% 0; background: var(--bow, #f2c14e);
    filter: drop-shadow(0 1px 0 rgb(0 0 0 / 0.4));
    -webkit-mask: var(--bow-shape) center / contain no-repeat; mask: var(--bow-shape) center / contain no-repeat; }
  .floor, .ribbon { --bow-shape: url("data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 100 50%27%3E%3Cpath d=%27M50 42C22 4 2 6 4 28 6 46 34 48 50 42ZM50 42C78 4 98 6 96 28 94 46 66 48 50 42Z%27/%3E%3Ccircle cx=%2750%27 cy=%2740%27 r=%279%27/%3E%3C/svg%3E"); }
  .box[data-bow="gold"], .ribbon[data-bow="gold"] { --bow: #f2c14e; }
  .box[data-bow="red"], .ribbon[data-bow="red"] { --bow: #b3142a; }
  .box[data-bow="green"], .ribbon[data-bow="green"] { --bow: #1f5a30; }
  .box[data-bow="white"], .ribbon[data-bow="white"] { --bow: #ffffff; }
  .box[data-bow="blue"], .ribbon[data-bow="blue"] { --bow: #1f4f9a; }
  .box[data-bow="none"] { --bow: transparent; }
  .box[data-bow="none"]::after { display: none; }
  .ribbon::before { content: ""; width: 1.8rem; height: 0.9rem; background: var(--bow, transparent); filter: drop-shadow(0 0 1px rgb(0 0 0 / 0.7));
    -webkit-mask: var(--bow-shape) center / contain no-repeat; mask: var(--bow-shape) center / contain no-repeat; }
  .box[data-mine="true"] { outline: 3px dashed #1f2633; outline-offset: 2px; box-shadow: 0 0 0 5px #ffffff, 0 3px 4px -2px rgb(0 0 0 / 0.55); }
  .box[data-wrap="red"], .paper[data-wrap="red"] { --paper: #c8243c; }
  .box[data-wrap="green"], .paper[data-wrap="green"] { --paper: #2f6b3f; }
  .box[data-wrap="gold"], .paper[data-wrap="gold"] { --paper: #d9a62e; }
  .box[data-wrap="blue"], .paper[data-wrap="blue"] { --paper: #2f5fa8; }
  .box[data-wrap="plaid"], .paper[data-wrap="plaid"] { --paper: repeating-linear-gradient(0deg, rgb(0 0 0 / 0.25) 0 4px, transparent 4px 10px), repeating-linear-gradient(90deg, #2f6b3f 0 6px, #a11224 6px 14px); }
  .box[data-wrap="stripes"], .paper[data-wrap="stripes"] { --paper: repeating-linear-gradient(-45deg, #c8243c 0 6px, #ffffff 6px 12px); }
  /* At the tree's foot: the floor comes first and reaches up to the trunk; the words follow it. */
  .under[data-state="shown"][data-tucked="true"] { display: flex; flex-direction: column; margin-top: 0; }
  .under[data-tucked="true"] > .floor { order: -1; z-index: 2; background: none; overflow: visible;
    margin-top: calc(-1 * (var(--tuck, 0px) + min(34vw, 11.5rem))); }
  .names { margin: 0.2rem 0; text-align: center; font-size: 0.95rem; overflow-wrap: anywhere; }
  .nudges { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .nudges button { min-height: 44px; padding: 0.4rem 0.7rem; font: inherit; border-radius: 8px; cursor: pointer; background: var(--card, #fffdf8); color: var(--foreground, #1f2633); border: 2px solid var(--border, #b9b4a6); }
  .go, .send, .stickers button, .tools button, .clear {
    min-height: 44px; padding: 0.5rem 1.1rem; font: inherit; border-radius: 8px; cursor: pointer;
    border: 2px solid var(--primary, #a11224); background: var(--primary, #a11224); color: var(--primary-foreground, #ffffff); }
  .go { display: block; margin: 0.6rem auto; }
  .stickers button, .tools button, .clear { background: var(--card, #fffdf8); color: var(--foreground, #1f2633); border-color: var(--border, #b9b4a6); padding: 0.4rem 0.7rem; }
  .tools button[aria-pressed="true"] { background: var(--primary, #a11224); color: var(--primary-foreground, #ffffff); border-color: var(--primary, #a11224); }
  button:focus-visible, input:focus-visible, textarea:focus-visible { outline: 3px solid var(--ring, #1f5fbf); outline-offset: 2px; }
  button:disabled { opacity: 0.6; cursor: default; }
  form { display: grid; gap: 0.9rem; margin-top: 0.8rem; padding: 1rem; border: 1px solid var(--border, #b9b4a6); border-radius: 10px; background: var(--card, #fffdf8); }
  [hidden] { display: none !important; }
  label, legend { font-weight: 600; }
  .field { display: grid; gap: 0.3rem; }
  input[type="text"], input[type="password"], textarea { font: inherit; min-height: 44px; padding: 0.5rem 0.6rem; border: 1px solid var(--border, #8d897c); border-radius: 6px; background: #ffffff; color: #1f2633; width: 100%; box-sizing: border-box; }
  textarea { min-height: 7rem; resize: vertical; }
  fieldset { display: grid; gap: 0.5rem; margin: 0; padding: 0; border: 0; min-width: 0; }
  .choices { display: flex; flex-wrap: wrap; gap: 0.3rem 1rem; }
  .choice { display: inline-flex; align-items: center; gap: 0.4rem; min-height: 44px; font-weight: 400; }
  .paper::before { content: ""; width: 1.4rem; height: 1.4rem; border-radius: 3px; background: var(--paper); border: 1px solid rgb(0 0 0 / 0.3); }
  .stickers, .swatches, .tools { display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: center; }
  .swatch { width: 44px; height: 44px; min-height: 44px; padding: 0; border-radius: 8px; border: 2px solid var(--border, #b9b4a6); background: var(--ink, #fffdf8); cursor: pointer; }
  .swatch[aria-pressed="true"] { outline: 3px solid var(--foreground, #1f2633); outline-offset: 2px; }
  .swatch[data-paper="design"] { background: linear-gradient(135deg, #1f3a5f 50%, #f7f3e8 50%); }
  input[type="color"] { width: 44px; height: 44px; padding: 0; border: 0; background: transparent; cursor: pointer; }
  .file { font-weight: 600; }
  .preview { touch-action: none; user-select: none; }
  .preview[data-tool="draw"], .preview[data-tool="text"] { cursor: crosshair; }
  .preview[data-tool="move"] { cursor: grab; }
  .preview[data-tool="erase"] { cursor: cell; }
  .preview svg { display: block; width: 100%; height: auto; border-radius: 10px; }
  .trap { position: absolute; left: -200vw; width: 1px; height: 1px; overflow: hidden; }
</style>
<gift-maker heading="Under the tree" shows="season">
  <section class="under" data-state={state} data-tucked={tucked ? 'true' : 'false'} aria-label={heading}>
    <h2 class="heading">{heading}</h2>
    <p class="count">{count()}</p>
    <div class="floor" role="img" aria-label={count()} hidden={open}>
      <zb-each items={pile()} as="b" key={b.id}>
        <span class="box" data-wrap={b.wrap} data-bow={b.bow} style:--x={left(b)} style:--y={foot(b)} style:--w={wide(b)} style:--z={near(b)}></span>
      </zb-each>
    </div>
    <p class="names">{fromWhom()}</p>
    <p class="said" role="status">{said}</p>
    <button class="go" type="button" hidden={open} onclick={start}>Leave a gift</button>
    <form hidden={!open} action={leave} method="post" onsubmit={send} oninput={choose} novalidate>
      <p class="help">It stays wrapped until Christmas morning. Only Grammi reads what you write.</p>
      <div class="field">
        <label for="gift-from">Your name</label>
        <input id="gift-from" name="from" type="text" maxlength="40" autocomplete="name" />
      </div>
      <label class="choice"><input type="checkbox" name="showName" /> Show my name on the box, for everyone to see</label>
      <fieldset>
        <legend>What are you leaving?</legend>
        <div class="choices">
          <label class="choice"><input type="radio" name="kind" value="note" checked /> A note</label>
          <label class="choice"><input type="radio" name="kind" value="card" /> A card I make here</label>
        </div>
      </fieldset>
      <div class="field" hidden={kind !== 'note'}>
        <label for="gift-note">Your note</label>
        <textarea id="gift-note" name="note" maxlength="1000"></textarea>
      </div>
      <fieldset hidden={kind !== 'card'}>
        <legend>Your card</legend>
        <div class="choices">
          <zb-each items={DESIGN_NAMES} as="d" key={d[0]}>
            <label class="choice"><input type="radio" name="design" value={d[0]} checked={d[0] === 'holly'} /> {d[1]}</label>
          </zb-each>
        </div>
        <p class="help">Pick a design, or a paper color of your own. Plain paper leaves the design’s drawings off. Then draw, write, and drag things where you want them.</p>
        <div class="swatches" role="group" aria-label="Card color">
          <zb-each items={PAPERS} as="c" key={c[1]}>
            <button type="button" class="swatch" data-paper={c[0] || 'design'} style:--ink={c[0] || '#f7f3e8'} aria-pressed={paperColor === c[0] ? 'true' : 'false'} aria-label={c[1]} onclick={(e) => choosePaper(e, c[0])}></button>
          </zb-each>
          <label class="choice">Other <input type="color" value={paperColor || '#fffdf8'} oninput={customPaper} aria-label="Another card color" /></label>
        </div>
        <label class="choice"><input type="checkbox" checked={plain} oninput={togglePlain} /> Plain paper</label>
        <div class="tools" role="group" aria-label="Card tools">
          <button type="button" aria-pressed={tool === 'move' ? 'true' : 'false'} onclick={(e) => useTool(e, 'move')}>Move</button>
          <button type="button" aria-pressed={tool === 'draw' ? 'true' : 'false'} onclick={(e) => useTool(e, 'draw')}>Draw</button>
          <button type="button" aria-pressed={tool === 'erase' ? 'true' : 'false'} onclick={(e) => useTool(e, 'erase')}>Erase</button>
          <button type="button" aria-pressed={tool === 'text' ? 'true' : 'false'} onclick={(e) => useTool(e, 'text')}>Words</button>
        </div>
        <div class="tools" hidden={tool !== 'draw'}>
          <zb-each items={INKS} as="c" key={c[0]}>
            <button type="button" class="swatch" style:--ink={c[0]} aria-pressed={pen === c[0] ? 'true' : 'false'} aria-label={c[1]} onclick={(e) => choosePen(e, c[0])}></button>
          </zb-each>
          <label class="choice">Other <input type="color" value={pen} oninput={customPen} aria-label="Another pen color" /></label>
          <zb-each items={PEN_SIZES} as="s" key={s[0]}>
            <button type="button" aria-pressed={penSize === s[0] ? 'true' : 'false'} onclick={() => chooseSize(s[0])}>{s[1]}</button>
          </zb-each>
        </div>
        <div class="field" hidden={tool !== 'text'}>
          <label for="gift-place">Words to put on the card</label>
          <input id="gift-place" type="text" maxlength="80" autocomplete="off" />
          <button type="button" onclick={(e) => placeText(e.currentTarget.form, 50, 42)}>Put them in the middle</button>
        </div>
        <div class="stickers">
          <zb-each items={STICKER_NAMES} as="s" key={s[0]}>
            <button type="button" disabled={stuck.length >= 8} onclick={(e) => stick(e, s[0])}>{s[1]}</button>
          </zb-each>
          <button class="clear" type="button" disabled={stuck.length === 0} onclick={unstick}>Take the stickers off</button>
        </div>
        <label class="file">Add a photo
          <input type="file" accept="image/jpeg,image/png" disabled={pictures.length >= 2} onchange={addPhoto} />
        </label>
        <p class="help">{pickedHelp()}</p>
        <div class="nudges">
          <button type="button" disabled={picked == null} onclick={(e) => nudgePicked(e, -4, 0)}>Left</button>
          <button type="button" disabled={picked == null} onclick={(e) => nudgePicked(e, 4, 0)}>Right</button>
          <button type="button" disabled={picked == null} onclick={(e) => nudgePicked(e, 0, -4)}>Up</button>
          <button type="button" disabled={picked == null} onclick={(e) => nudgePicked(e, 0, 4)}>Down</button>
          <button type="button" disabled={picked == null} onclick={(e) => turnPicked(e, -15)}>Turn left</button>
          <button type="button" disabled={picked == null} onclick={(e) => turnPicked(e, 15)}>Turn right</button>
          <button type="button" disabled={picked == null} onclick={(e) => sizePicked(e, -1)}>Smaller</button>
          <button type="button" disabled={picked == null} onclick={(e) => sizePicked(e, 1)}>Bigger</button>
          <button type="button" disabled={picked == null} onclick={frontPicked}>In front</button>
          <button type="button" disabled={picked == null} onclick={removePicked}>Remove</button>
        </div>
        <div class="nudges">
          <button class="clear" type="button" disabled={past.length === 0} onclick={undo}>Undo</button>
          <button class="clear" type="button" onclick={clearArt}>Start this card over</button>
        </div>
        <div class="preview" data-tool={tool} aria-label="Your card. Draw on it, or drag what you added." onpointerdown={onCardPointer} onpointermove={onCardPointer} onpointerup={onCardPointer} onpointercancel={onCardPointer}></div>
        <div class="field">
          <label for="gift-message">Words in the middle</label>
          <textarea id="gift-message" name="message" maxlength="300"></textarea>
        </div>
        <div class="field">
          <label for="gift-sign">How you sign it</label>
          <input id="gift-sign" name="signOff" type="text" maxlength="40" />
        </div>
      </fieldset>
      <fieldset>
        <legend>Wrapping paper</legend>
        <div class="choices">
          <zb-each items={WRAPS} as="w" key={w[0]}>
            <label class="choice paper" data-wrap={w[0]}><input type="radio" name="wrap" value={w[0]} checked={w[0] === 'red'} /> {w[1]}</label>
          </zb-each>
        </div>
      </fieldset>
      <fieldset>
        <legend>A bow on top</legend>
        <div class="choices">
          <zb-each items={BOWS} as="w" key={w[0]}>
            <label class="choice ribbon" data-bow={w[0]}><input type="radio" name="bow" value={w[0]} checked={w[0] === 'gold'} /> {w[1]}</label>
          </zb-each>
        </div>
      </fieldset>
      <fieldset>
        <legend>Where it goes under the tree</legend>
        <p class="help">Yours is the box with the dotted edge. Tap or drag on the floor to set it down, or use the buttons. It can lean on another gift, but not cover it.</p>
        <p class="help" hidden={tucked}>The gift pile is shown separately from the tree on this page.</p>
        <div class="placement-tree" hidden={!tucked}></div>
        <div class="floor" data-placing="true" role="img" aria-label="The gifts under the tree, with yours among them" onpointerdown={point} onpointermove={point}>
          <zb-each items={withMine()} as="b" key={b.id}>
            <span class="box" data-wrap={b.wrap} data-bow={b.bow} data-mine={b.mine ? 'true' : 'false'} style:--x={left(b)} style:--y={foot(b)} style:--w={wide(b)} style:--z={near(b)}></span>
          </zb-each>
        </div>
        <div class="nudges">
          <button type="button" onclick={() => nudge(-6, 0)}>Left</button>
          <button type="button" onclick={() => nudge(6, 0)}>Right</button>
          <button type="button" onclick={() => nudge(0, -15)}>Toward the back</button>
          <button type="button" onclick={() => nudge(0, 15)}>Toward the front</button>
        </div>
      </fieldset>
      <div class="field" hidden={!asks}>
        <label for="gift-code">The family password</label>
        <input id="gift-code" name="code" type="text" autocomplete="off" />
        <p class="help">Grammi can tell you what it is. Capitals and spaces don't matter.</p>
      </div>
      <div class="trap" aria-hidden="true"><label>Leave this empty <input name="website" type="text" tabindex="-1" autocomplete="off" /></label></div>
      <p class="problem" role="alert">{problem}</p>
      <button class="send" type="submit" disabled={busy}>{busy ? 'Putting it under the tree…' : 'Put it under the tree'}</button>
    </form>
  </section>
</gift-maker>
