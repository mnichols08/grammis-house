<!--
  Grammi's Christmas tree: a drawn fir she decorates herself. Twelve spots on the branches, each
  with the ornament she picks (or nothing), something on top, and lights that twinkle.

  topper  what's on top: "star" (default), "bow", "snowflake" or "none"
  nolights  leave the lights off (default: the lights are on)
  gifts   the family service's gifts address (…/api/gifts): gifts the family left sit wrapped
          under the tree, with the giver's name only where they and Grammi both said so
  shows   when it's on the page: "season" (from November 20 to January 6, the default) or "always"
  spot1   Near the top (default gold-ball)
  spot2   Upper branches, left (default red-ball)
  spot3   Upper branches, right (default candy-cane)
  spot4   Middle, far left (default bell)
  spot5   Middle (default heart)
  spot6   Middle, far right (default blue-ball)
  spot7   Lower, far left (default snowflake)
  spot8   Lower, left of center (default gingerbread)
  spot9   Lower, right of center (default red-ball)
  spot10  Lower, far right (default gold-ball)
  spot11  Bottom branches, left (default pinecone)
  spot12  Bottom branches, right (default bird)

  Every setting is a choice from a list, so nothing she sets is ever a position or markup. The
  ornaments are known when the page is built, so the server draws the whole tree; only whether
  it's in season waits for the browser's date.
-->
<script>
  import { onMount } from '@zubra/runtime'

  const NAMES = {"none": "nothing", "red-ball": "a red ball", "gold-ball": "a gold ball", "blue-ball": "a blue ball", "candy-cane": "a candy cane", "gingerbread": "a gingerbread man", "snowflake": "a snowflake", "bell": "a bell", "pinecone": "a pinecone", "heart": "a felt heart", "bird": "a little red bird"}
  const placed = [
    ['spot1', spot1],
    ['spot2', spot2],
    ['spot3', spot3],
    ['spot4', spot4],
    ['spot5', spot5],
    ['spot6', spot6],
    ['spot7', spot7],
    ['spot8', spot8],
    ['spot9', spot9],
    ['spot10', spot10],
    ['spot11', spot11],
    ['spot12', spot12],
  ]
    .map(([spot, kind]) => ({ spot, kind: NAMES[kind] && kind !== 'none' ? kind : '' }))
    .filter((o) => o.kind)
  const crown = ['star', 'bow', 'snowflake'].includes(topper) ? topper : topper === 'none' ? '' : 'star'
  const lit = !(nolights === true || nolights === 'true' || nolights === '')
  const said = (() => {
    const counts = {}
    for (const o of placed) counts[o.kind] = (counts[o.kind] || 0) + 1
    const parts = Object.entries(counts).map(([kind, n]) => (n === 1 ? NAMES[kind] : `${n} ${NAMES[kind].replace(/^an? /, '')}s`))
    const list = parts.length > 1 ? `${parts.slice(0, -1).join(', ')} and ${parts.at(-1)}` : parts[0] || 'no ornaments yet'
    const top = crown ? `, a ${crown} on top` : ''
    return `Grammi's Christmas tree, with ${list}${top}${lit ? ', and lights' : ''}.`
  })()

  let state = shows === 'always' ? 'shown' : 'hidden'
  let boxes = []
  let boxWords = ''

  // The wrapped boxes: who each is from (when shown) and its paper, never what's inside.
  const loadGifts = async () => {
    const address = String(gifts || '').trim().replace(/\/+$/, '')
    if (!/^https:\/\//.test(address)) return
    try {
      const reply = await (await fetch(`${address}/tree`, { credentials: 'omit' })).json()
      const papers = ['red', 'green', 'gold', 'blue', 'plaid', 'stripes']
      boxes = (reply.gifts || []).slice(0, 60).map((g, i) => ({
        id: String(g.id),
        wrap: papers.includes(g.wrap) ? g.wrap : 'red',
        from: typeof g.from === 'string' ? g.from.slice(0, 40) : '',
        tilt: ((i * 37) % 9) - 4,
      }))
      const n = boxes.length
      boxWords = n === 0 ? '' : n === 1 ? '1 gift under the tree' : `${n} gifts under the tree`
    } catch (_) {
      boxes = []
    }
  }

  onMount(() => {
    const now = new Date()
    const month = now.getMonth()
    const date = now.getDate()
    const inSeason = (month === 10 && date >= 20) || month === 11 || (month === 0 && date <= 6)
    if (shows === 'always' || inSeason) state = 'shown'
    loadGifts()
    const again = () => loadGifts()
    window.addEventListener('grammis-gift', again)
    return () => window.removeEventListener('grammis-gift', again)
  })
</script>
<style>
  :host { display: block; }
  .stand { display: none; }
  .stand[data-state="shown"] { display: block; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .stand { max-width: 26rem; margin: 1.5rem auto; text-align: center; }
  .tree { position: relative; width: 100%; aspect-ratio: 300 / 360; background: center / contain no-repeat; }
  .orn { position: absolute; width: 9%; aspect-ratio: 1; translate: -50% -50%; background: center / contain no-repeat; filter: drop-shadow(0 2px 1px rgb(0 0 0 / 0.25)); }
  .topper { position: absolute; left: 50%; top: 3%; width: 15%; aspect-ratio: 1; translate: -50% -50%; background: center / contain no-repeat; }
  .lights { position: absolute; inset: 8% 6% 14%; pointer-events: none;
    background:
      radial-gradient(circle, #fff6c8 0 2px, transparent 3px) 0 0 / 30px 34px,
      radial-gradient(circle, #ffd27a 0 2px, transparent 3px) 15px 17px / 30px 34px;
    clip-path: polygon(50% 0, 100% 100%, 0 100%);
    animation: twinkle 2.4s ease-in-out infinite alternate; }
  @keyframes twinkle { from { opacity: 0.45; } to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .lights { animation: none; opacity: 0.8; } }
  .under { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.35rem 0.6rem; margin: -2.2rem 0 0; padding: 0 1rem; list-style: none; position: relative; }
  .box { display: grid; justify-items: center; gap: 0.15rem; }
  .paper { width: 2.6rem; height: 2.2rem; border-radius: 4px; position: relative; box-shadow: 0 2px 2px rgb(0 0 0 / 0.25); background: #c8243c; }
  .paper::before, .paper::after { content: ""; position: absolute; background: #f2c14e; }
  .paper::before { left: 44%; width: 12%; top: 0; bottom: 0; }
  .paper::after { top: 40%; height: 14%; left: 0; right: 0; }
  .box[data-wrap="green"] .paper { background: #2f6b3f; }
  .box[data-wrap="gold"] .paper { background: #c99624; }
  .box[data-wrap="blue"] .paper { background: #2f5fa8; }
  .box[data-wrap="plaid"] .paper { background: repeating-linear-gradient(0deg, transparent 0 6px, rgb(0 0 0 / 0.22) 6px 9px), repeating-linear-gradient(90deg, #a31f33 0 6px, #2f6b3f 6px 9px); }
  .box[data-wrap="stripes"] .paper { background: repeating-linear-gradient(45deg, #c8243c 0 6px, #fff 6px 11px); }
  .tag { font-size: 0.75rem; line-height: 1.1; max-width: 5.5rem; overflow-wrap: anywhere; color: var(--foreground, #3a2418); }
  .count { margin: 0.4rem 0 0; font-family: var(--ob-font-hand, cursive); font-size: 1.25rem; color: var(--primary, #a3172b); }
  .orn[data-spot="spot1"] { left: 50%; top: 20%; }
  .orn[data-spot="spot2"] { left: 40%; top: 33%; }
  .orn[data-spot="spot3"] { left: 61%; top: 31%; }
  .orn[data-spot="spot4"] { left: 28%; top: 50%; }
  .orn[data-spot="spot5"] { left: 47%; top: 48%; }
  .orn[data-spot="spot6"] { left: 70%; top: 52%; }
  .orn[data-spot="spot7"] { left: 18%; top: 72%; }
  .orn[data-spot="spot8"] { left: 37%; top: 69%; }
  .orn[data-spot="spot9"] { left: 58%; top: 73%; }
  .orn[data-spot="spot10"] { left: 80%; top: 70%; }
  .orn[data-spot="spot11"] { left: 34%; top: 81%; }
  .orn[data-spot="spot12"] { left: 64%; top: 82%; }
  .tree { background-image: url("data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 300 360%27%3E%3Cpath d=%27M135 300h30v48h-30z%27 fill=%27%237a4a26%27/%3E%3Cpath d=%27M150 18 222 128h-26l58 92h-30l66 92H10l66-92H46l58-92H78z%27 fill=%27%232f6b3f%27/%3E%3Cpath d=%27M150 18 186 72l-10 2 46 54h-26l-46-110zM150 128l58 92h-30l66 92h-40l-54-92z%27 fill=%27%233f8a52%27 opacity=%27.55%27/%3E%3Cpath d=%27M60 300q90 22 180-4M88 210q62 18 124-4M110 124q40 12 80-2%27 stroke=%27%23e8c45a%27 stroke-width=%273%27 fill=%27none%27 stroke-dasharray=%272 6%27 stroke-linecap=%27round%27/%3E%3C/svg%3E"); }
  .orn[data-kind="red-ball"] { background-image: url("data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%27-12 -14 24 26%27%3E%3Crect x=%27-3%27 y=%27-13%27 width=%276%27 height=%274%27 rx=%271%27 fill=%27%23c9a24a%27/%3E%3Ccircle r=%2710%27 fill=%27%23c8243c%27/%3E%3Ccircle cx=%27-4%27 cy=%27-4%27 r=%273%27 fill=%27%23fff%27 opacity=%27.45%27/%3E%3C/svg%3E"); }
  .orn[data-kind="gold-ball"] { background-image: url("data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%27-12 -14 24 26%27%3E%3Crect x=%27-3%27 y=%27-13%27 width=%276%27 height=%274%27 rx=%271%27 fill=%27%23a9883a%27/%3E%3Ccircle r=%2710%27 fill=%27%23e0a12e%27/%3E%3Cpath d=%27M-10 0h20%27 stroke=%27%23fff3c4%27 stroke-width=%272%27/%3E%3Ccircle cx=%27-4%27 cy=%27-4%27 r=%273%27 fill=%27%23fff%27 opacity=%27.5%27/%3E%3C/svg%3E"); }
  .orn[data-kind="blue-ball"] { background-image: url("data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%27-12 -14 24 26%27%3E%3Crect x=%27-3%27 y=%27-13%27 width=%276%27 height=%274%27 rx=%271%27 fill=%27%23c9a24a%27/%3E%3Ccircle r=%2710%27 fill=%27%232f6fd0%27/%3E%3Cpath d=%27M-9-4q9 6 18 0M-9 4q9 6 18 0%27 stroke=%27%23cfe0ff%27 stroke-width=%271.6%27 fill=%27none%27/%3E%3C/svg%3E"); }
  .orn[data-kind="candy-cane"] { background-image: url("data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%27-12 -14 24 28%27%3E%3Cpath d=%27M3 13V-5a6 6 0 0 0-12 0%27 stroke=%27%23fff%27 stroke-width=%275%27 fill=%27none%27 stroke-linecap=%27round%27/%3E%3Cpath d=%27M3 13V-5a6 6 0 0 0-12 0%27 stroke=%27%23c8243c%27 stroke-width=%275%27 fill=%27none%27 stroke-dasharray=%273 3%27 stroke-linecap=%27round%27/%3E%3C/svg%3E"); }
  .orn[data-kind="gingerbread"] { background-image: url("data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%27-12 -13 24 26%27%3E%3Cpath d=%27M0-12a4.5 4.5 0 1 1 0 9 4.5 4.5 0 1 1 0-9M-4-3h8l7 4-2 3-5-2 3 9-3 2-4-6-4 6-3-2 3-9-5 2-2-3z%27 fill=%27%23b06a34%27/%3E%3Ccircle cx=%270%27 cy=%271%27 r=%271%27 fill=%27%23fff%27/%3E%3Ccircle cx=%270%27 cy=%274%27 r=%271%27 fill=%27%23fff%27/%3E%3C/svg%3E"); }
  .orn[data-kind="snowflake"] { background-image: url("data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%27-12 -12 24 24%27%3E%3Cg stroke=%27%237fb3e0%27 stroke-width=%272%27 stroke-linecap=%27round%27%3E%3Cpath d=%27M0-10V10M-8.7-5 8.7 5M-8.7 5 8.7-5%27/%3E%3Cpath d=%27M-3-8 0-5 3-8M-3 8 0 5 3 8%27 fill=%27none%27/%3E%3C/g%3E%3C/svg%3E"); }
  .orn[data-kind="bell"] { background-image: url("data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%27-12 -12 24 24%27%3E%3Cpath d=%27M0-9C-6-9-6-2-6 2L-8 6H8L6 2C6-2 6-9 0-9Z%27 fill=%27%23e0a12e%27/%3E%3Ccircle cy=%278%27 r=%272%27 fill=%27%23b8862a%27/%3E%3Cpath d=%27M-3-10C0-12 3-10 3-10%27 stroke=%27%23c8243c%27 stroke-width=%272%27 fill=%27none%27/%3E%3C/svg%3E"); }
  .orn[data-kind="pinecone"] { background-image: url("data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%27-12 -13 24 26%27%3E%3Cpath d=%27M0-10C7-6 8 6 0 12-8 6-7-6 0-10Z%27 fill=%27%238a5a2e%27/%3E%3Cpath d=%27M-5-2h10M-6 3h12M-4 8h8M-3-6h6%27 stroke=%27%235e3b1c%27 stroke-width=%271.5%27/%3E%3C/svg%3E"); }
  .orn[data-kind="heart"] { background-image: url("data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%27-12 -12 24 24%27%3E%3Cpath d=%27M0 9C-9 3-10-3-7-6-4-9 0-6 0-4 0-6 4-9 7-6 10-3 9 3 0 9Z%27 fill=%27%23d6455a%27 stroke=%27%23fff%27 stroke-width=%271.2%27 stroke-dasharray=%272 2%27/%3E%3C/svg%3E"); }
  .orn[data-kind="bird"] { background-image: url("data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%27-13 -10 26 20%27%3E%3Cpath d=%27M-10 2C-8-6 4-7 6-2L11-3 7 1C6 6-6 8-10 2Z%27 fill=%27%23c8243c%27/%3E%3Ccircle cx=%274%27 cy=%27-2%27 r=%271.2%27 fill=%27%23222%27/%3E%3Cpath d=%27M-4 0q3-4 6 0%27 stroke=%27%238e1626%27 stroke-width=%271.4%27 fill=%27none%27/%3E%3C/svg%3E"); }
  .topper[data-kind="star"] { background-image: url("data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%27-14 -14 28 28%27%3E%3Cpath d=%27M0-13 3.8-4.6 13-3.6 6.1 2.6 8 11.6 0 7 -8 11.6-6.1 2.6-13-3.6-3.8-4.6Z%27 fill=%27%23f2c14e%27 stroke=%27%23c99624%27 stroke-width=%271%27/%3E%3C/svg%3E"); }
  .topper[data-kind="bow"] { background-image: url("data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%27-16 -12 32 26%27%3E%3Cpath d=%27M0 0C-12-12-16 0-9 4-5 6-2 3 0 0ZM0 0C12-12 16 0 9 4 5 6 2 3 0 0Z%27 fill=%27%23c8243c%27/%3E%3Cpath d=%27M-1 2-7 13-2 11 1 14ZM1 2 7 13 2 11-1 14Z%27 fill=%27%239c1a27%27/%3E%3Crect x=%27-3.5%27 y=%27-3.5%27 width=%277%27 height=%277%27 rx=%272%27 fill=%27%23e0394c%27/%3E%3C/svg%3E"); }
  .topper[data-kind="snowflake"] { background-image: url("data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%27-12 -12 24 24%27%3E%3Cg stroke=%27%237fb3e0%27 stroke-width=%272%27 stroke-linecap=%27round%27%3E%3Cpath d=%27M0-10V10M-8.7-5 8.7 5M-8.7 5 8.7-5%27/%3E%3Cpath d=%27M-3-8 0-5 3-8M-3 8 0 5 3 8%27 fill=%27none%27/%3E%3C/g%3E%3C/svg%3E"); }
</style>
<grammis-tree topper="star" nolights={false} gifts="" shows="season" spot1="gold-ball" spot2="red-ball" spot3="candy-cane" spot4="bell" spot5="heart" spot6="blue-ball" spot7="snowflake" spot8="gingerbread" spot9="red-ball" spot10="gold-ball" spot11="pinecone" spot12="bird">
  <figure class="stand" data-state={state}>
    <div class="tree" role="img" aria-label={said}>
      <zb-if test={lit}><span class="lights" aria-hidden="true"></span></zb-if>
      <zb-if test={crown}><span class="topper" data-kind={crown} aria-hidden="true"></span></zb-if>
      <zb-each items={placed} as="o" key={o.spot}>
        <span class="orn" data-spot={o.spot} data-kind={o.kind} aria-hidden="true"></span>
      </zb-each>
    </div>
    <zb-if test={boxes.length}>
      <ul class="under" aria-label="Gifts under the tree">
        <zb-each items={boxes} as="b" key={b.id}>
          <li class="box" data-wrap={b.wrap} style:rotate={`${b.tilt}deg`}>
            <span class="paper" aria-hidden="true"></span>
            <span class="tag">{b.from ? `From ${b.from}` : ''}</span>
            <span class="visually-hidden">{b.from ? '' : 'A wrapped gift'}</span>
          </li>
        </zb-each>
      </ul>
      <p class="count">{boxWords}</p>
    </zb-if>
  </figure>
</grammis-tree>
