{
  "label": "No decorations (just the house)",
  "extends": "base",
  "customizable": [
    "textSize",
    "spacing",
    "pageWidth"
  ],
  "colorScheme": "light",
  "colors": {
    "light": {
      "page": "#f6f4ef",
      "outer": "#ece8df",
      "surface": "#fdfcf9",
      "surfaceRaised": "#efebe2",
      "text": "#26231f",
      "muted": "#55504a",
      "subtle": "#736c63",
      "border": "#d9d3c7",
      "accent": "#3f5f6b",
      "accentSoft": "#3f5f6b",
      "accentBorder": "#a9bfc6",
      "accentContrast": "#ffffff",
      "link": "#335562",
      "glow": "#dde8ea",
      "codeBg": "#efebe2",
      "codeText": "#26231f",
      "ink": "#26231f"
    },
    "dark": {
      "page": "#181a1b",
      "outer": "#111314",
      "surface": "#202426",
      "surfaceRaised": "#2a2f31",
      "text": "#ece8e1",
      "muted": "#c3bdb3",
      "subtle": "#9a948b",
      "border": "#3a4043",
      "accent": "#9cc3cf",
      "accentSoft": "#9cc3cf",
      "accentBorder": "#4d6b74",
      "accentContrast": "#141819",
      "link": "#acd0db",
      "glow": "#24363b",
      "codeBg": "#2a2f31",
      "codeText": "#ece8e1",
      "ink": "#141819"
    }
  },
  "fonts": {
    "body": "Georgia, \"Iowan Old Style\", \"Palatino Linotype\", serif",
    "heading": "\"Fraunces\", Georgia, serif",
    "faces": [
      {
        "family": "Fraunces",
        "src": "fonts/Fraunces.woff2",
        "format": "woff2",
        "weight": "300 900",
        "preload": true
      },
      {
        "family": "Fraunces",
        "src": "fonts/Fraunces-Italic.woff2",
        "format": "woff2",
        "weight": "300 900",
        "style": "italic"
      },
      {
        "family": "Caveat",
        "src": "fonts/Caveat-Bold.woff2",
        "format": "woff2",
        "weight": "700",
        "preload": true
      }
    ]
  },
  "tokens": {
    "bodySize": "1.1875rem",
    "bodyLeading": "1.8",
    "radius": "10px",
    "radiusSm": "5px",
    "headingWeight": "600",
    "headingTracking": "-0.01em",
    "decorGarland": "none",
    "decorGarlandHeight": "0px",
    "decorBanner": "none",
    "decorBannerSize": "auto",
    "decorBannerHeight": "0px",
    "decorBannerRepeat": "no-repeat",
    "decorCorner": "none",
    "decorCornerInset": "auto",
    "decorMantel": "none",
    "decorMantelSize": "auto",
    "decorMantelHeight": "0px",
    "decorPattern": "none",
    "decorPatternSize": "auto",
    "season": "\"\"",
    "decorCornerWidth": "0px",
    "decorCornerHeight": "0px",
    "fontHand": "\"Caveat\", \"Segoe Print\", \"Bradley Hand\", cursive",
    "weather": "none"
  },
  "options": {
    "listStyle": "cards",
    "postCovers": true
  },
  "stylesheets": [
    "house.css",
    "zubra-bridge.css",
    "components/holiday-countdown.css"
  ],
  "scripts": [
    "weather.js"
  ],
  "components": {
    "holiday-countdown": {
      "label": "Countdown sign",
      "description": "A little hanging sign that counts the days until a holiday.",
      "script": "components/holiday-countdown.js",
      "fallback": "A countdown sign to the holiday hangs here.",
      "props": [
        {
          "name": "holiday",
          "type": "choice",
          "label": "Which holiday",
          "default": "next",
          "choices": [
            {
              "value": "next",
              "label": "Whichever holiday comes next"
            },
            {
              "value": "new-year",
              "label": "New Year's Day"
            },
            {
              "value": "valentines",
              "label": "Valentine's Day"
            },
            {
              "value": "st-patricks",
              "label": "St. Patrick's Day"
            },
            {
              "value": "easter",
              "label": "Easter"
            },
            {
              "value": "mothers-day",
              "label": "Mother's Day"
            },
            {
              "value": "fathers-day",
              "label": "Father's Day"
            },
            {
              "value": "independence-day",
              "label": "Fourth of July"
            },
            {
              "value": "labor-day",
              "label": "Labor Day"
            },
            {
              "value": "halloween",
              "label": "Halloween"
            },
            {
              "value": "thanksgiving",
              "label": "Thanksgiving"
            },
            {
              "value": "christmas",
              "label": "Christmas"
            }
          ],
          "help": "The sign counts down to this day and says Happy \u2026 when it comes. \"Whichever holiday comes next\" keeps up with the calendar by itself."
        }
      ],
      "source": "components/holiday-countdown.zb"
    }
  }
}
